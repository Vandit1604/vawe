# Files a fresh worktree needs that .gitignore keeps out of git. `git worktree add` checks out tracked
# files only, and a page that misses one of these renders a fallback font or a grey box without an error.
# node_modules is shared by link-shared.sh, not copied.

# Licensed and vendored faces. Without them the renderer substitutes a fallback face.
assets/fonts/local/**
assets/fonts/*.woff2

# Captured brand images and cutouts a page references by relative path.
assets/brands/**
assets/cutouts/**

# Generated art a page references.
assets/gen/**
