#!/usr/bin/env node
// vawe: the one command for authoring, rendering and checking a page film. `vawe --help` lists the verbs.
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { execFileSync, spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { isUrl } from '../harness/lib/url.mjs';
import { closest, parseArgs, topHelp, UsageError, verbHelp } from '../harness/cli/parse.mjs';
import { VERBS, stripChromeNoise, commitsBehind, staleNote } from '../harness/cli/verbs.mjs';
import { newFilm, newFilmLines, readDetails, questionsJson } from '../harness/cli/new.mjs';
import { appendRun, readAllRuns, readRuns, filmKeyOf } from '../harness/lib/runlog.mjs';
import { pageDigest } from '../harness/lib/approval.mjs';
import { verbEvent, footerLine, filmOfCall, imagesIn, reasonOf, readNotes, causeOf, refusalOf, UNFILED } from '../harness/lib/verb-log.mjs';
import { namedRef, refsDir } from '../harness/lib/refs.mjs';
import { nextStep, recentPage } from '../harness/live/stage-say.mjs';
import { verbStage } from '../harness/lib/trace/stages.mjs';
import { recentFailedShipLines } from '../harness/lib/ship-status.mjs';
import { newEvent } from '../harness/lib/run-events.mjs';
import { doctorHintFromFile } from '../harness/lib/doctor-hint.mjs';
import { ensureHooks, gitAt } from '../harness/lib/git-hooks.mjs';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const MAX_SCAN = 4_000_000;

function requireFiles(verb, values, positional) {
  (verb.positional || []).forEach((p, i) => {
    if (p.kind === 'file' && !(p.remote && isUrl(positional[i])) && positional[i] && !fs.existsSync(positional[i])) throw new UsageError(`no such ${p.name}: ${positional[i]}`);
  });
  for (const f of verb.flags || []) {
    if (f.kind === 'file' && values[f.name] && !fs.existsSync(values[f.name])) throw new UsageError(`no such file for --${f.name}: ${values[f.name]}`);
  }
}

function runStep(step, call) {
  const argv = step.node || [path.join(ROOT, step.script), ...step.args];
  return new Promise((resolve) => {
    const child = spawn(process.execPath, argv, { stdio: ['inherit', 'pipe', 'pipe'], cwd: ROOT, env: { ...process.env, ...step.env, VAWE_VERB_NOTES: call.notes } });
    let stderr = '';
    child.stdout.on('data', (d) => { process.stdout.write(d); if (call.stdout.length < MAX_SCAN) call.stdout += d; });
    child.stderr.on('data', (d) => { stderr += d; });
    child.on('close', (code, signal) => {
      const clean = stripChromeNoise(stderr);
      process.stderr.write(clean);
      call.stderr = clean;
      const hint = code === 0 ? null : doctorHintFromFile(ROOT, stderr);
      if (hint) console.error(hint);
      resolve({ code: code ?? 1, signal });
    });
  });
}

async function execute(verb, rest, call) {
  if (verb.raw) call.positional = rest;
  if (verb.raw) return stepCode(await runStep(verb.build({}, rest)[0], call), call);
  const { values, positional } = parseArgs(verb, rest);
  call.positional = [...positional, ...(values.page ? [values.page] : [])];
  requireFiles(verb, values, positional);
  const named = verb.defaultRef && !values.ref && !values.alone ? namedRef({ dir: refsDir(), briefText: briefOf(verb.defaultRef(values, positional)) }) : null;
  if (named) {
    values.ref = named.file;
    console.log(`ref: ${named.id}, named in the brief (${named.file}); pass --ref to use another`);
  }
  const steps = verb.build ? verb.build(values, positional) : null;
  if (!steps && values['questions-json']) {
    const { length, aspect, request, from } = values;
    console.log(JSON.stringify(questionsJson(positional[0], { request, from, length, aspect, details: readDetails(values) }), null, 2));
    return 0;
  }
  if (!steps) {
    const made = newFilm(positional[0], { from: values.from, root: ROOT, length: values.length, aspect: values.aspect, title: values.title, request: values.request, details: readDetails(values), defaults: values.defaults });
    if (!made.asked) {
      appendRun(positional[0], newEvent({ template: made.template, length: made.length, answered: made.answered, guessed: made.guesses, ranges: made.ranges }), { root: ROOT });
    }
    console.log(newFilmLines(positional[0], made).join('\n'));
    for (const line of recentFailedShipLines(readAllRuns(path.join(ROOT, 'out')), Date.now())) console.error(line);
    return 0;
  }
  const startedMs = Date.now();
  for (const [i, step] of steps.entries()) {
    if (step.label) console.log(`\n[${verb.name} ${i + 1}/${steps.length}: ${step.label}]`);
    const code = stepCode(await runStep(step, call), call);
    if (code !== 0) return code;
  }
  if (typeof verb.report === 'function') console.log(verb.report(values, positional, startedMs).join('\n'));
  const next = verb.next && !verb.nextInline ? verb.next(values, positional) : null;
  if (next) console.log(`\nnext: ${next}`);
  return 0;
}

function stepCode({ code, signal }, call) {
  call.signal = signal;
  return code;
}

function orNone(read, none) {
  try { return read(); } catch (e) {
    if (e.code === 'ENOENT') return none;
    throw e;
  }
}

function briefOf(input) {
  const page = input && String(input).endsWith('.html') ? input : input && filmKeyOf(input) ? path.join('films', filmKeyOf(input), 'page.html') : null;
  return page ? orNone(() => fs.readFileSync(path.resolve(ROOT, path.dirname(page), 'brief.md'), 'utf8'), '') : '';
}

/** The film a call concerns and its page: the page or mp4 it names, else the page film git sees as edited last (a remote still names none). */
function filmOfRun(verbName, call, rest) {
  const named = filmOfCall(verbName, call.positional, rest);
  const given = call.positional.find((p) => p.endsWith('.html'));
  const page = given ? path.resolve(ROOT, given)
    : named !== UNFILED ? path.join(ROOT, 'films', named, 'page.html') : recentPage(ROOT);
  return { film: named === UNFILED && page ? filmKeyOf(page) : named, page };
}

function stageOf(verbName, rest, film, page) {
  const used = Object.fromEntries(readRuns(film, ROOT).filter((r) => r.cmd === 'verb' && r.exitCode === 0).map((r) => [r.verb, true]));
  return verbStage({ verb: verbName, args: rest.join(' ') }, used) ?? (page ? orNone(() => nextStep(page, ROOT).stage, null) : null);
}

function record(verb, rest, call, code, reason, endMs) {
  const { film, page } = filmOfRun(verb.name, call, rest);
  const pageHash = page ? orNone(() => pageDigest(page), null) : null;
  const event = verbEvent({ verb: verb.name, args: rest, stage: stageOf(verb.name, rest, film, page), startMs: call.startMs, endMs, exitCode: code, reason, slotWaitS: readNotes(call.notes).slotWaitS ?? null, images: imagesIn(call.stdout), pageHash, help: call.help, usage: call.usage, refused: refusalOf(call.stderr) });
  try {
    appendRun(film, event, { root: ROOT });
  } catch (e) {
    console.error(`vawe: could not write the run log: ${e.message}`);
  }
}

const bareCall = () => ({ startMs: Date.now(), positional: [], stdout: '', stderr: '', signal: null, notes: '', help: false, usage: false });

const quietFooter =(rest) => rest.includes('--json') || rest.includes('--questions-json');

async function main(argv) {
  const [name, ...rest] = argv;
  const hooksLine = ensureHooks(gitAt(ROOT));
  if (hooksLine) console.error(hooksLine);
  if (!name || name === '--help' || name === '-h' || name === 'help') return console.log(topHelp(VERBS, { all: rest.includes('--all') }));
  const verb = VERBS.find((v) => v.name === name);
  if (!verb) {
    const guess = closest(name, VERBS.map((v) => v.name));
    const stale = staleNote(commitsBehind((args) => execFileSync('git', args, { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })));
    const message = `unknown verb ${name}; valid: ${VERBS.map((v) => v.name).join(' ')}${guess ? `; did you mean ${guess}?` : ''}${stale ? `; ${stale}` : ''}`;
    console.error(`vawe: ${message}`);
    console.log(footerLine({ verb: name, code: 2, reason: `unknown verb ${name}`, seconds: 0 }));
    record({ name }, rest, { ...bareCall(), usage: true }, 2, `unknown verb ${name}`, Date.now());
    process.exitCode = 2;
    return;
  }
  if (rest.includes('--help') || rest.includes('-h')) {
    record(verb, rest, { ...bareCall(), help: true }, 0, null, Date.now());
    return console.log(verbHelp(verb));
  }
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'vawe-verb-'));
  const call = { ...bareCall(), notes: path.join(dir, 'notes.jsonl') };
  let code = 0;
  let reason = null;
  try {
    code = await execute(verb, rest, call);
    if (code !== 0) reason = reasonOf({ code, signal: call.signal, stderr: call.stderr });
    const fix = code !== 0 && verb.fix ? verb.fix(reason, call.positional) : null;
    if (fix) console.error(`fix: ${fix}`);
    if (code !== 0 && causeOf(reason) === 'browser lost') {
      const { browserLog } = await import('../harness/media/preview-server.mjs');
      for (const log of [browserLog(true), browserLog(false)].filter((f) => fs.existsSync(f))) console.error(`Chrome log (why the browser was lost): ${log}`);
    }
  } catch (e) {
    call.usage = e instanceof UsageError;
    code = e instanceof UsageError ? 2 : 1;
    reason = e instanceof UsageError ? e.message : `exit 1: ${e.message}`;
    console.error(e instanceof UsageError ? `vawe: ${e.message}` : e.stack);
    const hint = e instanceof UsageError ? null : doctorHintFromFile(ROOT, String(e.stack));
    if (hint) console.error(hint);
  }
  const endMs = Date.now();
  record(verb, rest, call, code, reason, endMs);
  fs.rmSync(dir, { recursive: true, force: true });
  if (!quietFooter(rest)) console.log(footerLine({ verb: verb.name, code, reason, seconds: (endMs - call.startMs) / 1000 }));
  process.exitCode = code;
}

main(process.argv.slice(2));
