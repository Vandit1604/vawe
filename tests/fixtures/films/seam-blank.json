      "bg2": "{color.bg2}",
      "surface": "{color.surface}",
      "surface2": "{color.surface2}",
      "line": "{color.line}",
      "lineStrong": "{color.lineStrong}",
      "text": "{color.text}",
      "text2": "{color.text2}",
      "dim": "{color.dim}",
      "accent": "{color.accent}",
