{
  "name": "vawe-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../scripts/site/site-engine.mjs",
    "dev": "next dev",
    "prebuild": "node ../scripts/site/site-engine.mjs",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "next lint",
    "dev:docs": "npm --prefix ../docs-site run dev -- -p 3001",
    "dev:all": "node ../scripts/site/dev-all.mjs",
    "//build": "Builds into .next-build so a production build cannot corrupt the dev server's .next. Set via NEXT_DIST_DIR + next.config.mjs, because --distDir is not a CLI flag in Next 15."
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
