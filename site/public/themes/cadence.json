{
  "name": "cadence",
  "note": "Made-up product theme for the Cadence launch clip, built in the higgsfield register: near-black field, ONE amber accent, and no third colour except the app chrome's greys. Faces are tracked free files (Bricolage Grotesque + Geist Mono), never Sohne (that one is paid and lives in the gitignored local/ folder, so a clean clone would silently fall back to the body face). exitRatio 0.4: things leave faster than they arrive.",
  "motion": {
    "easing": "easeOutCubic",
    "bounce": 0.08,
    "settle": 0.3,
    "enter": 34,
    "durationScale": 0.82,
    "stagger": 0.032,
    "exitRatio": 0.4
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#07080a"
      },
      "bg2": {
        "$type": "color",
        "$value": "#0b0d10"
      },
      "surface": {
        "$type": "color",
        "$value": "#14161b"
      },
      "surface2": {
        "$type": "color",
        "$value": "#1c1f26"
      },
      "line": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.07)"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.16)"
      },
      "text": {
        "$type": "color",
        "$value": "#f4f1ea"
      },
      "text2": {
        "$type": "color",
        "$value": "#a49e92"
      },
      "dim": {
        "$type": "color",
        "$value": "#6e695f"
      },
      "accent": {
        "$type": "color",
        "$value": "#ffb020"
      },
      "accentDim": {
        "$type": "color",
        "$value": "rgba(255,176,32,0.16)"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(255,176,32,0.5)"
      },
      "up": {
        "$type": "color",
        "$value": "#ffb020"
      },
      "down": {
        "$type": "color",
        "$value": "#e05a3a"
      },
      "ink": {
        "$type": "color",
        "$value": "#f4f1ea"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Bricolage Grotesque"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Bricolage Grotesque"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#0c0a06"
      },
      "stop1": {
        "$type": "color",
        "$value": "#08080a"
      },
      "stop2": {
        "$type": "color",
        "$value": "#000000"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
    "text": "{color.text}",
    "text2": "{color.text2}",
    "dim": "{color.dim}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "accentGlow": "{color.accentGlow}",
    "up": "{color.up}",
    "down": "{color.down}",
    "ink": "{color.ink}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  },
  "look": {
    "bgDefault": {
      "preset": "plain"
    },
    "bgPalette": {
      "accent": "255,176,32",
      "tint": "120,96,40",
      "tint2": "255,214,140",
      "dotLight": "70,58,28",
      "paperBase": [
        "#0c0a06",
        "#000000"
      ],
      "softBase": [
        "#0e0c08",
        "#000000"
      ],
      "accentBase": [
        "#ffb020",
        "#a06f10"
      ],
      "inkBase": [
        "#08080a",
        "#000000"
      ],
      "border": "#1e1a12",
      "dark": [
        "#0c0a06",
        "#000000"
      ],
      "darkMesh": [
        "#0e0c08",
        "#000000"
      ],
      "deep": [
        "#08080a",
        "#000000"
      ],
      "light": [
        "#14161b",
        "#000000"
      ],
      "ink": [
        "#08080a",
        "#000000"
      ],
      "paper": "#07080a"
    },
    "surface": "neon"
  }
}
