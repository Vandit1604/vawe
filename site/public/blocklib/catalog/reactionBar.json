{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "reactionBar",
  "type": "vawe:block",
  "title": "reactionBar",
  "description": "emoji reaction pills with counts, like the reactions under a Slack or Discord message",
  "tags": [
    "reactionBar"
  ],
  "dimensions": {
    "width": 272,
    "height": 79
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "reactionBar",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "reactions": [
        {
          "emoji": "🔥",
          "count": 24,
          "mine": true
        },
        {
          "emoji": "👍",
          "count": 12
        },
        {
          "emoji": "🎉",
          "count": 5
        }
      ]
    },
    "props": [
      "x",
      "y",
      "reactions",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/reactionBar.json",
      "url": "https://vawe.dev/assets/blocks/reactionBar.json",
      "target": "films/scene/reactionBar.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/reactionBar.png"
  }
}
