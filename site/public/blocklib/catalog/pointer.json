{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "pointer",
  "type": "vawe:block",
  "title": "pointer",
  "description": "a mouse cursor that travels across the screen to a target and clicks it, with a click ripple.",
  "tags": [
    "pointer"
  ],
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "pointer",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "to": {
        "dx": 300,
        "dy": 190
      },
      "clickAt": 1.3,
      "size": 44
    },
    "props": [
      "x",
      "y",
      "to",
      "clickAt",
      "clicks",
      "path",
      "size",
      "color",
      "rippleColor",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/pointer.json",
      "url": "https://vawe.dev/assets/blocks/pointer.json",
      "target": "films/scene/pointer.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/pointer.png"
  }
}
