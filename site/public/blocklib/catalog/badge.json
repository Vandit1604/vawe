{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "badge",
  "type": "vawe:block",
  "title": "badge",
  "description": "a small label plus coloured value chip, like a CI shield or a status token (e.g. version, warning, beta).",
  "tags": [
    "badge"
  ],
  "dimensions": {
    "width": 214,
    "height": 78
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "badge",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "label": "build",
      "value": "passing",
      "tone": "ok"
    },
    "props": [
      "x",
      "y",
      "label",
      "value",
      "tone",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/badge.json",
      "url": "https://vawe.dev/assets/blocks/badge.json",
      "target": "films/scene/badge.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/badge.png"
  }
}
