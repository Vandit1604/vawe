   "html": "<style>\n  .sp-pane{box-sizing:border-box;width:100%;height:100%;background:var(--paper);\n    border:1px solid #D6D6D2;border-radius:14px;padding:26px 30px;\n    display:flex;flex-direction:column;gap:14px;overflow:hidden}\n  .sp-bar{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:15px;color:#757570}\n  .sp-dot{width:7px;height:7px;border-radius:50%;background:#C96442}\n  .sp-row{display:flex;flex-direction:column;gap:5px}\n  .sp-h{font-family:var(--font-sans);font-weight:600;font-size:22px;color:#0A0A0A}\n  .sp-b{font-family:var(--font-mono);font-weight:400;font-size:15px;color:#5C5C58}\n  .sp-rule{height:1px;background:#E8E8E5}\n</style><div class=\"sp-pane\"><div class=\"sp-bar\"><span class=\"sp-dot\"></span>preface.md</div><div class=\"sp-rule\"></div><div class=\"sp-row\"><div class=\"sp-h\">Person</div><div class=\"sp-b\">Solo founder. Deploy dashboard.</div></div><div class=\"sp-row\"><div class=\"sp-h\">Voice</div><div class=\"sp-b\">Answer first, then what backs it.</div></div><div class=\"sp-row\"><div class=\"sp-h\">Rhythm</div><div class=\"sp-b\">Deep work 7 to 11am.</div></div><div class=\"sp-row\"><div class=\"sp-h\">Limits</div><div class=\"sp-b\">No date without a spare week.</div></div></div>"
