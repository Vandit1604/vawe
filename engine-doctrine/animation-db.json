  "dotAnimation": {
    "spacing": "48-64px",
    "radius": "1.5-3 -> peak 4-6",
    "baseAlpha": "0.06-0.20",
    "peakAlpha": "0.3-0.6",
    "modes": [
      "wave",
      "ripple",
      "pulse"
    ],
    "drift": "8-14 px/s (seamless: grid period == spacing)",
    "waveField": "0.5+0.5*sin(t*omega - (x+y)*k), k~=0.03"
  },
  "easing": {
    "emphasized": "cubic-bezier(.2,0,0,1)",
    "enter": "cubic-bezier(.05,.7,.1,1)",
    "exit": "cubic-bezier(.3,0,.8,.15)",
    "expoOut": "cubic-bezier(.16,1,.3,1)",
    "backOut": "cubic-bezier(.34,1.56,.64,1)",
    "backIn": "cubic-bezier(.36,0,.66,-.56)",
    "inEngine": [
      "easeOutExpo",
      "easeOutBack",
      "spring",
      "easeOutCubic"
    ]
  },
  "timing": {
    "microMs": "150-200",
    "enterMs": "300-400",
    "transitionMs": "375-500",
    "exitFactor": 0.7,
    "staggerMs": "40-80",
    "cascadeCapMs": 300,
    "holdPerWordS": 0.3,
    "holdFloorS": 1.4
  },
  "transitions": [
    {
      "name": "dipToColor",
      "ms": "250-400",
      "when": "chapter change / brand beat",
      "built": true
    },
    {
      "name": "push",
      "ms": "350-500",
      "when": "sequential, directional",
      "built": true
    },
    {
      "name": "wipe",
      "ms": "300-450",
      "when": "energetic reveal",
      "built": true
    },
    {
      "name": "maskReveal",
