      "built": true
    },
    {
      "name": "scalePunch",
      "ms": "200-350",
      "when": "beat-synced emphasis",
      "built": true
    },
    {
      "name": "crossfade",
      "ms": "200-300",
      "when": "calm, light-to-light",
      "built": true
    },
    {
      "name": "matchCut",
      "ms": "400-600",
      "when": "carry accent shape across",
      "built": false
    }
  ],
