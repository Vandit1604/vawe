    "border": "#E8E8E5",
    "dark": ["#0F0F0E", "#050504"],
    "darkMesh": ["#14110F", "#050504"],
    "deep": ["#0F0F0E", "#050504"],
    "light": ["#FCFCFC", "#F1F1EF"],
    "ink": ["#0F0F0E", "#050504"],
    "paper": "#FCFCFC"
  },
  "vars": {
    "--ink": "#0A0A0A",
