{
  "name": "vawe-creed",
  "note": "Vawe launch film in CREED art-direction: 90% paper-white typographic stage, ONE terracotta accent used only as thin marks (left-edge bar, ticks, underlines), white hairline cards (no shadows, elevation = 1px line), Geist / Geist Mono. Motion is punchy but never overshoots (bounce 0, ease-out only, faster than creed's base).",
  "palette": {
    "bg": "#FCFCFC",
    "bg2": "#F7F7F5",
    "surface": "#FFFFFF",
    "surface2": "#F7F7F5",
    "line": "#E8E8E5",
    "lineStrong": "#D6D6D2",
    "text": "#0A0A0A",
    "text2": "#5C5C58",
    "dim": "#9A9A94",
    "ink": "#0A0A0A",
    "accent": "#C96442",
    "accentDim": "rgba(201,100,66,0.12)",
    "accentGlow": "rgba(201,100,66,0.30)",
    "up": "#1A7F4B",
    "down": "#C0362C"
  },
  "gradient": ["#FCFCFC", "#F7F7F5", "#F1F1EF"],
  "type": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "num": "Geist Mono",
    "serif": "Geist"
  },
  "motion": {
    "easing": "easeOutExpo",
