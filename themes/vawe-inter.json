{
  "name": "vawe-inter",
  "note": "THE VAWE BRAND — derived from the real site (site/app/globals.css + layout.tsx), not invented. WHITE-first with one cobalt accent: bg #ffffff, accent #2563eb (5.17:1 on white, so it clears AA at any size). The site's ACTUAL faces are Anybody (next/font, wdth+wght axes) for sans + JetBrains Mono for mono/numbers — NOT Space Grotesk (that was the prior guess; corrected 2026-07). up/down mirror the site's --ok #2f7d55 / --bad #a3282d. Two-surface accent: cobalt on light, ice-blue #8fc0ff on a charcoal code slab (cobalt on #0f1620 is ~2.5:1 and unreadable). Flat field, no texture: the site is plain white, so bgDefault is `plain` (MISTAKES.md #2).",
  "motion": {
    "easing": "easeOutExpo",
    "bounce": 0.02,
    "settle": 0.5,
    "enter": 36,
    "durationScale": 0.95,
    "stagger": 0.055
  },
  "bg": {
    "accent": "37,99,235",
    "tint": "180,190,205",
    "tint2": "205,214,226",
    "dotLight": "150,163,182",
    "paperBase": [
      "#ffffff",
      "#f6f8fb"
    ],
    "softBase": [
      "#f8fafc",
      "#eef2f8"
    ],
    "accentBase": [
      "#eef3ff",
      "#f8fafc"
    ],
    "inkBase": [
      "#0f1620",
      "#0a0f16"
    ],
    "border": "#e7eaf0",
    "dark": [
      "#0f1620",
      "#0a0f16"
    ],
    "darkMesh": [
      "#141d2a",
      "#0a0f16"
    ],
    "deep": [
      "#0f1620",
      "#080c12"
    ],
    "light": [
      "#ffffff",
      "#f6f8fb"
    ],
    "ink": [
      "#0f1620",
      "#0a0f16"
    ],
    "paper": "#ffffff"
  },
  "vars": {
    "--ink": "#0f1620",
    "--paper": "#ffffff",
    "--muted": "#697182",
    "--em": "#2563eb",
    "--on-light": "#0f1620",
    "--on-dark": "#ffffff",
    "--border": "#e7eaf0",
    "--accent-soft": "rgba(37,99,235,0.10)"
  },
  "bgDefault": {
    "preset": "plain"
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "bg2": {
        "$type": "color",
        "$value": "#f6f8fb"
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "surface2": {
        "$type": "color",
        "$value": "#f6f8fb"
      },
      "line": {
        "$type": "color",
        "$value": "#e7eaf0"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#d7dce4"
      },
      "text": {
        "$type": "color",
        "$value": "#0f1620"
      },
      "text2": {
        "$type": "color",
        "$value": "#454f5e"
      },
      "dim": {
        "$type": "color",
        "$value": "#697182"
      },
      "accent": {
        "$type": "color",
        "$value": "#2563eb"
      },
      "accentDim": {
        "$type": "color",
        "$value": "rgba(37,99,235,0.10)"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(37,99,235,0.30)"
      },
      "up": {
        "$type": "color",
        "$value": "#2f7d55"
      },
      "down": {
        "$type": "color",
        "$value": "#a3282d"
      },
      "ink": {
        "$type": "color",
        "$value": "#0f1620"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Anybody"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "stop1": {
        "$type": "color",
        "$value": "#f8fafc"
      },
      "stop2": {
        "$type": "color",
        "$value": "#f1f4f9"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
    "text": "{color.text}",
    "text2": "{color.text2}",
    "dim": "{color.dim}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "accentGlow": "{color.accentGlow}",
    "up": "{color.up}",
    "down": "{color.down}",
    "ink": "{color.ink}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  }
}