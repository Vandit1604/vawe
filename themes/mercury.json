{
  "name": "mercury",
  "note": "Mercury-inspired: near-black graphite canvas, strictly monochrome ivory-on-onyx with a single cobalt accent (#5266eb) used sparingly, intermediate type weight (never bold), flat borderless graphite cards. Darkness is the message. Motion: calm, restrained, zero bounce.",
  "motion": {
    "easing": "easeOutExpo",
    "bounce": 0,
    "settle": 0.4,
    "enter": 24,
    "durationScale": 1,
    "stagger": 0.05
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#0d0d11"
      },
      "bg2": {
        "$type": "color",
        "$value": "#131319"
      },
      "surface": {
        "$type": "color",
        "$value": "#1a1a22"
      },
      "surface2": {
        "$type": "color",
        "$value": "#131319"
      },
      "line": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.07)"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.13)"
      },
      "text": {
        "$type": "color",
        "$value": "#ece9e2"
      },
      "text2": {
        "$type": "color",
        "$value": "#a8a8b0"
      },
      "dim": {
        "$type": "color",
        "$value": "#6a6a72"
      },
      "accent": {
        "$type": "color",
        "$value": "#5266eb"
      },
      "accentDim": {
        "$type": "color",
        "$value": "rgba(82,102,235,0.16)"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(82,102,235,0.40)"
      },
      "up": {
        "$type": "color",
        "$value": "#5266eb"
      },
      "down": {
        "$type": "color",
        "$value": "#5266eb"
      },
      "ink": {
        "$type": "color",
        "$value": "#16161d"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Geist"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Geist"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#141420"
      },
      "stop1": {
        "$type": "color",
        "$value": "#0e0e14"
      },
      "stop2": {
        "$type": "color",
        "$value": "#08080c"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
    "text": "{color.text}",
    "text2": "{color.text2}",
    "dim": "{color.dim}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "accentGlow": "{color.accentGlow}",
    "up": "{color.up}",
    "down": "{color.down}",
    "ink": "{color.ink}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  },
  "look": {
    "bgPalette": {
      "accent": "82,102,235",
      "tint": "106,106,114",
      "tint2": "82,102,235",
      "dotLight": "120,120,132",
      "paperBase": [
        "#ffffff",
        "#f5f5f5"
      ],
      "softBase": [
        "#1a1e33",
        "#12162a"
      ],
      "accentBase": [
        "#5266eb",
        "#3d4fd4"
      ],
      "inkBase": [
        "#111119",
        "#08080c"
      ],
      "border": "#232330",
      "dark": [
        "#111119",
        "#08080c"
      ],
      "darkMesh": [
        "#14141f",
        "#08080c"
      ],
      "deep": [
        "#0c0c12",
        "#050508"
      ],
      "light": [
        "#ffffff",
        "#f5f5f5"
      ],
      "ink": [
        "#111119",
        "#08080c"
      ],
      "paper": "#0d0d11"
    }
  }
}
