{
  "name": "vawe-site",
  "note": "Cinematic-dark theme for the Vawe landing page renders. Deep charcoal field, one ice-blue accent, Space Grotesk display + JetBrains Mono. Free faces only (no Sohne).",
  "motion": {
    "easing": "easeOutCubic",
    "bounce": 0.03,
    "settle": 0.7,
    "enter": 40,
    "durationScale": 1.05,
    "stagger": 0.06
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#14161a"
      },
      "bg2": {
        "$type": "color",
        "$value": "#101216"
      },
      "surface": {
        "$type": "color",
        "$value": "#1b1e23"
      },
      "surface2": {
        "$type": "color",
        "$value": "#22262c"
      },
      "line": {
        "$type": "color",
        "$value": "#2a2e34"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#3b414a"
      },
      "text": {
        "$type": "color",
        "$value": "#eef1f4"
      },
      "text2": {
        "$type": "color",
        "$value": "#c4cad2"
      },
      "dim": {
        "$type": "color",
        "$value": "#7d848d"
      },
      "accent": {
        "$type": "color",
        "$value": "#6ab8ff"
      },
      "accentDim": {
        "$type": "color",
        "$value": "rgba(106,184,255,0.14)"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(106,184,255,0.40)"
      },
      "up": {
        "$type": "color",
        "$value": "#6ab8ff"
      },
      "down": {
        "$type": "color",
        "$value": "#7d848d"
      },
      "ink": {
        "$type": "color",
        "$value": "#0c0e11"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Space Grotesk"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Space Grotesk"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#16181d"
      },
      "stop1": {
        "$type": "color",
        "$value": "#121419"
      },
      "stop2": {
        "$type": "color",
        "$value": "#0e1014"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
    "text": "{color.text}",
    "text2": "{color.text2}",
    "dim": "{color.dim}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "accentGlow": "{color.accentGlow}",
    "up": "{color.up}",
    "down": "{color.down}",
    "ink": "{color.ink}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  },
  "look": {
    "bgDefault": {
      "preset": "deep"
    },
    "bgPalette": {
      "accent": "106,184,255",
      "tint": "60,72,88",
      "tint2": "40,50,62",
      "dotLight": "70,86,104",
      "paperBase": [
        "#14161a",
        "#0f1115"
      ],
      "softBase": [
        "#1b1e23",
        "#121419"
      ],
      "accentBase": [
        "#1a2330",
        "#101319"
      ],
      "inkBase": [
        "#0c0e11",
        "#08090c"
      ],
      "border": "#2a2e34",
      "dark": [
        "#14161a",
        "#0d0f13"
      ],
      "darkMesh": [
        "#181b21",
        "#0d0f13"
      ],
      "deep": [
        "#121419",
        "#0d0f13"
      ],
      "light": [
        "#1b1e23",
        "#14161a"
      ],
      "ink": [
        "#0c0e11",
        "#08090c"
      ],
      "paper": "#14161a"
    }
  }
}
