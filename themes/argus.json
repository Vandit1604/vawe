{
  "name": "argus",
  "note": "argushq.cc — 'grow on X, on purpose'. White-first, cobalt accent (the pixel-eye mascot + primary CTA), Archivo light-display + JetBrains Mono. Near-monochrome; cobalt is the only colour.",
  "motion": {
    "easing": "easeOutExpo",
    "bounce": 0.08,
    "settle": 0.4,
    "enter": 34,
    "durationScale": 0.9,
    "stagger": 0.04,
    "exitRatio": 0.45,
    "_exitRatio": "a security brand: things leave decisively. Asymmetric timing: an entrance is an introduction, an exit is over (engine-doctrine/CRAFT/MOTION-STANDARDS.md)."
  },
  "bg": {
    "accent": "71,114,245",
    "tint": "138,143,156",
    "tint2": "121,149,241",
    "dotLight": "200,208,230",
    "paperBase": [
      "#ffffff",
      "#f5f8ff"
    ],
    "softBase": [
      "#eef3ff",
      "#e2ecff"
    ],
    "accentBase": [
      "#4772f5",
      "#3a5fe0"
    ],
    "inkBase": [
      "#0a0b0e",
      "#05060a"
    ],
    "border": "#e4e7ef",
    "dark": [
      "#0a0b0e",
      "#05060a"
    ],
    "darkMesh": [
      "#0e1220",
      "#05060a"
    ],
    "deep": [
      "#0a0c14",
      "#05060a"
    ],
    "light": [
      "#ffffff",
      "#f5f8ff"
    ],
    "ink": [
      "#0a0b0e",
      "#05060a"
    ],
    "paper": "#ffffff"
  },
  "bgDefault": {
    "preset": "plain",
    "value": "light"
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "bg2": {
        "$type": "color",
        "$value": "#f7f9ff"
      },
      "surface": {
        "$type": "color",
        "$value": "#f7f9ff"
      },
      "surface2": {
        "$type": "color",
        "$value": "#eef1f7"
      },
      "line": {
        "$type": "color",
        "$value": "#e4e7ef"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#c9cddb"
      },
      "text": {
        "$type": "color",
        "$value": "#16181d"
      },
      "text2": {
        "$type": "color",
        "$value": "#565a63"
      },
      "dim": {
        "$type": "color",
        "$value": "#6a6f78"
      },
      "ink": {
        "$type": "color",
        "$value": "#0a0b0e"
      },
      "accent": {
        "$type": "color",
        "$value": "#4772f5"
      },
      "accentDim": {
        "$type": "color",
        "$value": "#7995f1"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(71,114,245,0.30)"
      },
      "accent2": {
        "$type": "color",
        "$value": "#8da7f9"
      },
      "up": {
        "$type": "color",
        "$value": "#1a9e57"
      },
      "down": {
        "$type": "color",
        "$value": "#e5484d"
      },
      "grid": {
        "$type": "color",
        "$value": "#eef1f7"
      },
      "grid2": {
        "$type": "color",
        "$value": "#e4e7ef"
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.7)"
      },
      "highlight": {
        "$type": "color",
        "$value": "#4772f5"
      },
      "card": {
        "$type": "color",
        "$value": "#ffffff"
