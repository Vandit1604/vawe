    "ink": "{color.ink}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "accentGlow": "{color.accentGlow}",
    "accent2": "{color.accent2}",
    "up": "{color.up}",
    "down": "{color.down}",
    "grid": "{color.grid}",
    "grid2": "{color.grid2}",
    "glass": "{color.glass}",
    "highlight": "{color.highlight}",
    "card": "{color.card}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  }
