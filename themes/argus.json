        "$type": "fontFamily",
        "$value": "Archivo"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Archivo"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "stop1": {
        "$type": "color",
        "$value": "#f7f9ff"
      },
      "stop2": {
        "$type": "color",
        "$value": "#eaf0ff"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
