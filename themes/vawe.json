{
  "name": "vawe",
  "note": "THE VAWE BRAND — derived from the real site (site/app/globals.css + layout.tsx), not invented. WHITE-first with one cobalt accent: bg #ffffff, accent #2563eb (5.17:1 on white, so it clears AA at any size). The site's ACTUAL faces are Anybody (next/font, wdth+wght axes) for sans + JetBrains Mono for mono/numbers — NOT Space Grotesk (that was the prior guess; corrected 2026-07). up/down mirror the site's --ok #2f7d55 / --bad #a3282d. Two-surface accent: cobalt on light, ice-blue #8fc0ff on a charcoal code slab (cobalt on #0f1620 is ~2.5:1 and unreadable). Flat field, no texture: the site is plain white, so bgDefault is `plain` (MISTAKES.md #2).",
  "palette": {
    "bg": "#ffffff",
    "bg2": "#f6f8fb",
    "surface": "#ffffff",
    "surface2": "#f6f8fb",
    "line": "#e7eaf0",
    "lineStrong": "#d7dce4",
    "text": "#0f1620",
    "text2": "#454f5e",
    "dim": "#697182",
    "accent": "#2563eb",
    "accentDim": "rgba(37,99,235,0.10)",
    "accentGlow": "rgba(37,99,235,0.30)",
    "up": "#2f7d55",
    "down": "#a3282d",
    "ink": "#0f1620"
  },
  "gradient": ["#ffffff", "#f8fafc", "#f1f4f9"],
  "type": {
    "sans": "Anybody",
    "serif": "Anybody",
    "mono": "JetBrains Mono",
    "num": "JetBrains Mono"
  },
  "motion": {
    "easing": "easeOutExpo",
    "bounce": 0.08,
    "settle": 0.5,
    "enter": 36,
    "durationScale": 0.88,
    "stagger": 0.045
  },
  "bg": {
    "accent": "37,99,235",
    "tint": "180,190,205",
    "tint2": "205,214,226",
    "dotLight": "150,163,182",
    "paperBase": ["#ffffff", "#f6f8fb"],
    "softBase": ["#f8fafc", "#eef2f8"],
    "accentBase": ["#eef3ff", "#f8fafc"],
    "inkBase": ["#0f1620", "#0a0f16"],
    "border": "#e7eaf0",
    "dark": ["#0f1620", "#0a0f16"],
    "darkMesh": ["#141d2a", "#0a0f16"],
    "deep": ["#0f1620", "#080c12"],
    "light": ["#ffffff", "#f6f8fb"],
    "ink": ["#0f1620", "#0a0f16"],
    "paper": "#ffffff"
  },
  "vars": {
    "--ink": "#0f1620",
    "--paper": "#ffffff",
    "--muted": "#697182",
    "--em": "#2563eb",
    "--on-light": "#0f1620",
    "--on-dark": "#ffffff",
    "--border": "#e7eaf0",
    "--accent-soft": "rgba(37,99,235,0.10)"
  },
  "bgDefault": {
    "preset": "plain"
  }
}
