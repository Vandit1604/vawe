{
  "name": "together-chat",
  "note": "EYEDROPPED from refs/together-chat.mp4, not invented. This is a RECREATION theme: the reference film's own palette, sampled off its real frames so the recreation can be compared against it pixel for pixel. Accent #066bfe is the send button and the one blue word, measured at 6.9s and 16.5s; the ground is #fdfdfd, a near-pure white that is NOT #ffffff and reads warmer than our own; ink is #171c25, sampled from the input bar's own type. It exists to benchmark the engine against a real film. It is not a vawe brand theme.",
  "motion": {
    "easing": "easeOutExpo",
    "bounce": 0,
    "settle": 0.55,
    "enter": 30,
    "durationScale": 0.9,
    "stagger": 0.05,
    "exitRatio": 0.35
  },
  "bgDefault": {
    "preset": "plain"
  },
  "look": {
    "backdrop": [
      "paper"
    ],
    "scale": {
      "hook": 92,
      "headline": 64,
      "body": 34,
      "caption": 22
    },
    "layout": {
      "anchor": "center",
      "margin": 150
    },
    "cuts": {
      "default": "fade",
      "accent": "fade"
    },
    "field": {
      "grain": 0,
      "vignette": 0
    }
  },
  "tokens": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#fdfdfd"
      },
      "bg2": {
        "$type": "color",
        "$value": "#f7f8fa"
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "surface2": {
        "$type": "color",
        "$value": "#f4f6f9"
      },
      "line": {
        "$type": "color",
        "$value": "#e9eaee"
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#d6d8de"
      },
      "text": {
        "$type": "color",
        "$value": "#171c25"
      },
      "ink": {
        "$type": "color",
        "$value": "#171c25"
      },
      "text2": {
        "$type": "color",
        "$value": "#54565c"
      },
      "dim": {
        "$type": "color",
        "$value": "#8b8b8d"
      },
      "accent": {
        "$type": "color",
        "$value": "#066bfe"
      },
      "accentDim": {
        "$type": "color",
        "$value": "rgba(6,107,254,0.10)"
      },
      "up": {
        "$type": "color",
        "$value": "#2f7d55"
      },
      "down": {
        "$type": "color",
        "$value": "#a3282d"
      },
      "accentGlow": {
        "$type": "color",
        "$value": "rgba(6,107,254,0.30)"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Geist"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Geist"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      },
      "num": {
        "$type": "fontFamily",
        "$value": "Geist Mono"
      }
    },
    "gradient": {
      "stop0": {
        "$type": "color",
        "$value": "#066bfe"
      },
      "stop1": {
        "$type": "color",
        "$value": "#4a94ff"
      },
      "stop2": {
        "$type": "color",
        "$value": "#e8f1ff"
      }
    }
  },
  "roles": {
    "ground": "{color.bg}",
    "bg2": "{color.bg2}",
    "surface": "{color.surface}",
    "surface2": "{color.surface2}",
    "line": "{color.line}",
    "lineStrong": "{color.lineStrong}",
    "text": "{color.text}",
    "ink": "{color.ink}",
    "text2": "{color.text2}",
    "dim": "{color.dim}",
    "accent": "{color.accent}",
    "accentDim": "{color.accentDim}",
    "up": "{color.up}",
    "down": "{color.down}",
    "accentGlow": "{color.accentGlow}",
    "font.sans": "{font.sans}",
    "font.serif": "{font.serif}",
    "font.mono": "{font.mono}",
    "font.num": "{font.num}",
    "gradient": [
      "{gradient.stop0}",
      "{gradient.stop1}",
      "{gradient.stop2}"
    ]
  }
}