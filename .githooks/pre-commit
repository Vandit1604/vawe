#!/bin/sh
# pre-commit, under 2 s. Blocks on: an em dash, a `node --check` failure in staged js/mjs, a staged js/mjs more tangled than at HEAD.
# Doc references and count ratchets (bench) only warn. Bypass with `git commit --no-verify` when you know better.
set -u

[ -f harness/dev/link-shared.sh ] && sh harness/dev/link-shared.sh

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

fail=0

node harness/dev/no-emdash.mjs >/dev/null 2>&1 || { node harness/dev/no-emdash.mjs; fail=1; }

for f in $(printf '%s\n' "$staged" | grep -E '\.(js|mjs)$' | grep -v '^site/'); do
  node --check "$f" || fail=1
  printf '{"tool_input":{"file_path":"%s"}}' "$PWD/$f" | node harness/live/code-quality.mjs || fail=1
done

docs="$(printf '%s\n' "$staged" | grep -E '\.md$' | grep -vE '^site/')"
# shellcheck disable=SC2086
[ -n "$docs" ] && { node quality/gates/doc-refs.mjs $docs; }

node harness/dev/bench.mjs fast 2>&1 | grep -E 'grew' >&2

[ "$fail" = 0 ] || { echo "pre-commit blocked. Fix the lines above, or --no-verify." >&2; exit 1; }
exit 0
