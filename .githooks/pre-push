#!/bin/sh
# Pre-push gate: block a push if the framework health checks fail (schema drift, broken primitives).
# Bypass with `git push --no-verify` when you know better.
#
# Installed via `make install-hooks` (sets core.hooksPath to .githooks).

# craft-coverage is here because a doc-only commit never runs an authoring gate. The doc index went red
# for weeks with four orphaned guides and a link to a file nobody wrote, and nothing noticed, because the
# only thing that checked it was a command you had to remember to type. This is the place it cannot be
# skipped by forgetting. It is pure file reads, so it costs about a second.
# doc-refs joined it once docs/MISTAKES.md was patched. Same argument: a doc names a command as an
# instruction, and an instruction that fails teaches the author to distrust the whole file. It found
# 111 usage strings printing a path that had moved months earlier.
echo "▶ pre-push: framework gates (schema-check + lib-test + craft-coverage + doc-refs) …"
if ! make schema-check lib-test craft-coverage doc-refs; then
  echo "✗ pre-push blocked: framework check failed. Fix it, or push with --no-verify to override." >&2
  exit 1
fi
echo "✓ pre-push: framework healthy"
