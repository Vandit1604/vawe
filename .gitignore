node_modules/
# out/ is the scratch directory every author tool writes to (renders, mixes, logs, sound-vary specs,
# the gallery build): every file in it is regenerable, none is source. `out/**/*.<ext>` rules used to
# list this out file-extension by file-extension and still missed `.m4a` (12 files reached main that
# way); ignoring the whole tree by pattern is the fix that can't be outrun by a new extension.
# `!out/.gitkeep` keeps the directory present in a fresh clone.
out/
!out/.gitkeep
assets/*.mp3
# no font binary ships from this repo, paid or not (CREDITS.md): woff2 already covered above,
# a bare .woff (e.g. a paid Klim face used locally for fidelity) is the same rule, same directory.
assets/fonts/*.woff2
assets/fonts/*.woff
.DS_Store

# go
bin/

# verify + previews (generated output). out/ itself is covered wholesale above; these two live
# outside out/.
quality/runs/out/
verify/*_contactsheet.png
quality/runs/frames/
# gate-mutation's exclusive lock: it edits tracked source in place, so two runs must not overlap.
# Removed on exit; a leftover one means a run was killed — check `git status` before trusting the tree.
quality/fixtures/.gate-mutation.lock

# transient DOM snapshot baselines (make snap)
quality/baselines/snap/*
# …except the digest: one sha256 per scene plus the font state, ~10KB. It is what lets a fresh clone
# and CI answer "did this scene move" when the 20MB of full signatures beside it cannot be committed.
!quality/baselines/snap/digest.json

# review receipts: proof a beats/reveal sheet was rendered for a given scene content hash
# (make beats / make reveal write them, quality/gates/beat-check.mjs reads them). Local, per-machine.
quality/runs/beats-seen/
quality/baselines/approved/

# make evals: every timestamped run + compare dir is scratch, mp4s included. quality/runs/evals/baseline/ is
# the one committed run, and only its sheets + manifest.json, never its mp4s (they are gigabytes across
# a library; see engine-doctrine/CRAFT/EVALS.md and harness/dev/evals.mjs saveBaseline()).
quality/runs/evals/runs/
quality/runs/evals/baseline/*.mp4

# kie.ai secret + generated assets
.kie.key
assets/gen
# baked simulation frames: 480+ PNGs, ~67MB, regenerated by `make sim`. Provenance lives in
# meta.json and `make sim-audit` fails if a bake is stale, so the frames themselves are build output.
assets/baked/
quality/ledger/
assets/brands/**
!assets/brands/
!assets/brands/*/
!assets/brands/*/house-style.md
# The agent marks the preface-launch compatibility ring names. They are tracked (so a clone has
# them) and the site serves preface-launch in its editor; site-engine.mjs refuses to build a site
# whose scenes reference assets the clone will not have. 144K, and every one is the mark of the
# tool it names. The captured DOM that used to be allowlisted here is gone: the film builds its
# file pane from our own primitives.
!assets/brands/preface/agents/
!assets/brands/preface/agents/*.svg

# The subject of the `looks` film, for the same reason as the capture above: the site serves looks.json
# in its editor, and site-engine.mjs refuses to build a site whose scenes name an asset the clone will
# not have. The previous file here was tracked only because it predated this rule, and it carried no
# licence record at all. This one is CC0 with its source URL in the folder's credits.json.
!assets/brands/looks/photos/
!assets/brands/looks/photos/michelangelo-david-sculpture-head-2.webp
!assets/brands/looks/photos/credits.json

# paid/licensed fonts — used locally for fidelity, never committed (redistribution)
assets/fonts/local/

# vendored skill with no declared license — kept local, not redistributed (see CREDITS.md)
skills/taste-skill/

# fetched sound effects — same policy as fonts (never committed; `make sfx` re-fetches).
# credits.json IS tracked (attribution + pinned Mixkit ids for reproducible fetches).
assets/sfx/*.wav

# Video/data instances are NOT the framework (framework = scene.html + schema.json + sample.json).
# Keep the engine + schema + reference sample tracked; ignore the authored videos.
formats/scene/*.json
!formats/scene/sample.json
!formats/scene/schema.json
# ...but the repo's OWN demos are framework presentation, not content: the README film and the
# showcase clips are what the project ships to explain itself, and an untracked source means a
# clean clone cannot rebuild them (the same "not reproducible from the repo" bug class as a scene
# whose aspect lived in shell history). Brand films (argus/stripe/linear) stay untracked — those
# are content.
!formats/scene/vawe-intro.json
!formats/scene/hero-site.json
!formats/scene/showcase-*.json
# ...but NOT their expansions. `make expand` writes <name>.expanded.json beside the source, and that is
# build output: scripts/site/scenes-json.mjs treats it as regenerable and says so. The showcase
# allowlist above is a glob, so it was quietly re-including the generated file too.
formats/scene/*.expanded.json
!formats/scene/site-backdrop.json
# gh-wrapped is a TEMPLATE, not a video: it carries {{placeholders}} and renders nothing on its own.
# harness/media/gh-wrapped.mjs is tracked, and an untracked template would leave a clean clone holding
# a generator with no consumer, which is the "not reproducible from the repo" case this section exists
# to prevent. The RENDERED instance (formats/scene/_batch/) stays ignored, because that is content.
!formats/scene/gh-wrapped.template.json
# The camera-blur A/B. Not a film: it is the fixture `engine-doctrine/MISTAKES.md` #552 and the effects
# catalogue both cite, a whip pan across two depth planes plus one layer that counter-pans, so
# the smear and the cancellation can be re-rendered rather than taken on trust. An untracked
# fixture leaves both references naming a file a clean clone does not have.
!formats/scene/_camera-blur-probe.json
# ...but its DATA is one account's stats at one moment: regenerable from the API, stale the next day,
# and somebody's record rather than the framework. Same policy as assets/gen.
formats/scene/_data/
formats/scene/_batch/
# auto-orient: the A/B pair for AE technique 12 (engine-doctrine/CRAFT/AE-TECHNIQUES.md). Two files that differ
# in one key, the `upright` modifier on each carried mark, so the verdict can be re-rendered rather
# than taken on trust. A worked example the docs NAME and a clone does not have is not an example.
!formats/scene/_auto-orient.json
!formats/scene/_auto-orient-plain.json
# motion-test: the before/after snap demo — a permanent engine demo AND a motion regression fixture.
!formats/scene/motion-test.json
# flagship examples + their registry — the showcase the repo ships (make gallery).
!formats/scene/example-*.json
!formats/scene/examples.json
# ...but NOT their expansions, same bug as the showcase-* glob above: this allow is a glob too, so it
# was quietly re-including example-*.expanded.json, the compiled twin nobody should learn from.
formats/scene/example-*.expanded.json
# TEMPLATES. These are the framework's answer to "how is a launch film shaped": the composition,
# timing, camera and beat structure of a real film with every borrowed identity removed. The product
# is fictional, every colour is a theme token, the marks are inline svg. They ship on purpose. Their
# `.expanded.json` siblings do NOT — those are generated by `make expand`, like any build output.
!formats/scene/saas-hero-launch.json
!formats/scene/product-feature-tour.json
# Music beds are third-party tracks and the Mixkit licence forbids redistributing the files, so the
# audio never lands in git. credits.json is not audio, it is the PROVENANCE, and ignoring the whole
# directory meant the one file that records where a bed came from could not survive a clone — while
# SOUND.md told authors to record provenance there. Same policy as assets/sfx/ above.
assets/music/*
!assets/music/credits.json
# music.wav is BAKED by `make audio` (core/audio-kit.mjs) — generated, never committed.
assets/music.wav

# vendored engine copies for the web player (generated by scripts/site/site-engine.mjs).
# assets/{fonts,icons,vendor} land inside the site's OWN tracked assets/ dir, so they are ignored
# by name rather than by folder.
site/public/core/
site/public/themes/
site/public/formats/
site/public/assets/fonts/
site/public/assets/icons/
site/public/assets/vendor/
# same rule: site-engine copies these out of assets/brands/ because a scene names them. Committing
# them would put a second copy of a tracked file in the repo, free to drift from the original.
site/public/assets/brands/

# local scratch (agent shell logs) — never commit
/scratchpad/


# Raw cut-out letter SOURCES: 850MB of 1-3MB PNGs, re-extractable from the pack zip at any time.
# The BAKED sprite set (assets/ransom, 21MB) is local-only now (Resource Boy, no-redistribute): re-bake with `make ransom-sprites`.
assets/ransom-src/*
!assets/ransom-src/README.md

# MCP server working data (records, scenes, drafts, exports)
.vawe-data/

# the baked draft watermark sheet (make watermark)
assets/watermark/

# generated per-render derivatives (regenerate with make beatsync / make examples)
formats/scene/*.beatsync.json
build/

# reference films: third-party marketing videos downloaded for LOCAL STUDY ONLY (measure timings,
# easing, beat structure). Never committed, never shipped, never reproduced pixel-for-pixel — a
# recreation reproduces INTENT with our own assets (engine-doctrine/CRAFT/RECREATION.md).
refs/
# grammar/ is NOT ignored, and the pair is the point. `refs/` holds other people's films; `grammar/`
# holds what we measured and concluded about them: shot lengths, luma, motion, one accent hex, and the
# sentences a person wrote about what causes what. No frame, no crop, no copy, no mark. The pixels stay
# out of the repo and the reading stops dying with the checkout.
.venv-tools/
assets/cutouts/

# agent worktrees (harness/dev/worktree.sh)
.claude/worktrees/

# npm pack output — a build artifact, never committed
*.tgz

# ── THIRD-PARTY BRAND RECREATIONS MUST NOT REACH THE PUBLIC REPO ────────────────────────────────
# `formats/scene/*.json` above keeps the AUTHORED brand films untracked. It never covered their
# OUTPUTS or the site's own COPIES, and both were tracked: a rendered mp4 of stripe.com carries
# Stripe's headline, gradient and body copy verbatim, and site/public/scenes/ held the sources at a
# path no rule above matches. Films and scene copies are now allowlisted, not blocklisted, so a new
# brand recreation cannot slip in by being named something nobody thought to exclude.
#
# Reference films downloaded for study (refs/ above) plus any stray render at the repo root.
/*.mp4

# Site film clips: only the repo's OWN products and the fillable TEMPLATES ship.
site/public/assets/films/*
