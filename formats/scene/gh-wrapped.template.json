{
  "module": "scene",
  "theme": "vawe-dark",
  "duration": 28.0,
  "_note": "TEMPLATE. Render with: make batch TPL=formats/scene/gh-wrapped.template.json DATA=formats/scene/_data/gh-wrapped.json. Every {{key}} comes from scripts/media/gh-wrapped.mjs, which reads the GitHub API. No figure here is typed by hand.",
  "audio": {
    "silent": true,
    "_why": "the contribution map is read, not watched, and a bed under a 28s stat film competes with the counters for the same attention. A voice track is the right next pass, not a bed."
  },
  "authoring": {
    "allow": []
  },
  "bg": [
    { "from": 0, "to": 28.0, "preset": "constellation" }
  ],
  "_transitions": "one boundary per beat. `blur` is the right family here because the map stays put across every cut: the frame refocuses rather than travels, so the continuous object never appears to jump.",
  "transitions": [
    { "at": 5.0, "fx": "blur", "dur": 0.4 },
    { "at": 9.6, "fx": "blur", "dur": 0.4 },
    { "at": 14.2, "fx": "blur", "dur": 0.4 },
    { "at": 18.4, "fx": "blur", "dur": 0.4 },
    { "at": 22.6, "fx": "blur", "dur": 0.4 }
  ],
  "_grid": "one vertical rhythm for every beat, because six beats improvising their own y is how the first cut collided at 2.6s: headline 280/400, number 620, caption 900, the map at 1150, footer 1660. Headlines are sized so they do NOT wrap. A wrapped headline grows DOWNWARD into whatever sits under it, and nothing in the scene declares that it did.",
  "layers": [
    {
      "_": "THE CONTINUOUS OBJECT. 366 real days, on screen from the first frame to the last, and it CHANGES: the quiet cells arrive first, the loud ones ignite on the turn at 5.0s. The film's subject, not its decoration.",
      "type": "html",
      "src": "{{heat}}",
      "_x": "left-aligned to the same x=90 column as every headline, not centred. Centred at w:980 it spanned 50..1030 and broke the safe area, and a map that shares the text's left edge reads as part of the same document.",
      "x": 90,
      "y": 1150,
      "w": 900,
      "start": 0.0,
      "duration": 28.7,
      "anim": "fade",
      "enterDur": 0.5,
      "parts": [
        { "select": ".dim", "anim": "popIn", "each": 0.45, "stagger": 0.004, "delay": 0.15 },
        { "select": ".lit", "anim": "popIn", "each": 0.55, "stagger": 0.013, "delay": 5.0, "ease": "back.out(1.8)" }
      ],
      "motion": [
        { "t": 0, "y": 0, "scale": 1 },
        { "t": 22.0, "y": 0, "scale": 1, "ease": "linear" },
        { "t": 23.4, "y": 210, "scale": 0.9, "ease": "easeInOutSine" },
        { "t": 28.0, "y": 210, "scale": 0.9, "ease": "linear" }
      ]
    },

    { "_": "BEAT 1, the hook. The gap IS the story, so the map shows it and the words only name it.",
      "type": "text", "text": "Six months,", "x": 90, "y": 280, "w": 900, "size": 100, "weight": 800,
      "color": "var(--text)", "split": "word", "preset": "up", "each": 0.5, "stagger": 0.08,
      "start": 0.15, "duration": 4.6, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "<b>almost nothing.</b>", "x": 90, "y": 400, "w": 900, "size": 100, "weight": 800,
      "color": "var(--accent)", "split": "word", "preset": "up", "each": 0.5, "stagger": 0.08,
      "start": 0.7, "duration": 4.05, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "{{quietfrom}} to {{quietto}}", "x": 90, "y": 620, "w": 900, "size": 44,
      "font": "mono", "color": "var(--text-2)", "anim": "fade", "enterDur": 0.5,
      "start": 1.8, "duration": 2.95, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "{{activedays}} active days out of {{totaldays}}", "x": 90, "y": 900, "w": 900,
      "size": 36, "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 2.4, "duration": 2.35, "out": "fade", "exitDur": 0.4 },

    { "_": "BEAT 2, the turn. The counter and the igniting cells are the same event, so they share a clock.",
      "type": "text", "text": "Then {{loudmonth}}.", "x": 90, "y": 280, "w": 900, "size": 100, "weight": 800,
      "color": "var(--text)", "split": "char", "preset": "up", "each": 0.42, "stagger": 0.03,
      "start": 5.1, "duration": 4.1, "out": "fade", "exitDur": 0.4 },
    { "type": "count", "from": 0, "to": {{loudcount}}, "x": 90, "y": 480, "w": 900,
      "size": 220, "weight": 800, "color": "var(--accent)", "ls": "-0.04em",
      "countStart": 0.2, "countDur": 1.7, "ease": "easeOutExpo",
      "start": 5.4, "duration": 3.8, "anim": "fade", "enterDur": 0.3, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "contributions in one month", "x": 90, "y": 900, "w": 900, "size": 36,
      "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 6.4, "duration": 2.8, "out": "fade", "exitDur": 0.4 },

    { "_": "BEAT 3, the peak. One day carries it, so the day gets the last word of the beat.",
      "type": "text", "text": "{{peakmonth}} beat it.", "x": 90, "y": 280, "w": 900, "size": 100, "weight": 800,
      "color": "var(--text)", "split": "word", "preset": "up", "each": 0.45, "stagger": 0.07,
      "start": 9.7, "duration": 4.1, "out": "fade", "exitDur": 0.4 },
    { "type": "count", "from": 0, "to": {{peakmonthcount}}, "x": 90, "y": 480, "w": 900,
      "size": 220, "weight": 800, "color": "var(--accent)", "ls": "-0.04em",
      "countStart": 0.2, "countDur": 1.6, "ease": "easeOutExpo",
      "start": 10.0, "duration": 3.8, "anim": "fade", "enterDur": 0.3, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "{{peakcount}} of them on {{peakday}} alone", "x": 90, "y": 900, "w": 900,
      "size": 36, "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 11.0, "duration": 2.8, "out": "fade", "exitDur": 0.4 },

    { "_": "BEAT 4, the streak. A run of days is a SHAPE, so the number sits above the map that holds it.",
      "type": "text", "text": "The longest run", "x": 90, "y": 280, "w": 900, "size": 76, "weight": 700,
      "color": "var(--text-2)", "anim": "rise", "enterDur": 0.5,
      "start": 14.3, "duration": 3.9, "out": "fade", "exitDur": 0.4 },
    { "type": "count", "from": 0, "to": {{streak}}, "suffix": " days", "x": 90, "y": 450, "w": 900,
      "size": 200, "weight": 800, "color": "var(--text)", "ls": "-0.04em",
      "countStart": 0.2, "countDur": 1.4, "ease": "easeOutExpo",
      "start": 14.5, "duration": 3.7, "anim": "fade", "enterDur": 0.3, "out": "fade", "exitDur": 0.4 },
    { "type": "text", "text": "without missing one, ending {{streakend}}", "x": 90, "y": 900, "w": 900,
      "size": 36, "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 15.4, "duration": 2.8, "out": "fade", "exitDur": 0.4 },

    { "_": "BEAT 5, where it went. Bars, because the LENGTH is the number: nobody has to compare two sets of digits.",
      "type": "text", "text": "Where it went", "x": 90, "y": 280, "w": 900, "size": 76, "weight": 700,
      "color": "var(--text-2)", "anim": "rise", "enterDur": 0.5,
      "start": 18.5, "duration": 4.0, "out": "fade", "exitDur": 0.4 },

    { "type": "rect", "x": 90, "y": 460, "w": 820, "h": 76, "radius": 8, "color": "var(--accent)",
      "start": 18.8, "duration": 3.7, "anim": "wipe-right", "enterDur": 0.7, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo1}}", "x": 118, "y": 479, "w": 480, "size": 38, "weight": 700,
      "font": "mono", "color": "var(--bg)", "anim": "fade", "enterDur": 0.4,
      "start": 19.2, "duration": 3.3, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo1n}}", "x": 610, "y": 479, "w": 272, "align": "right", "size": 38,
      "weight": 700, "font": "mono", "color": "var(--bg)", "anim": "fade", "enterDur": 0.4,
      "start": 19.2, "duration": 3.3, "out": "fade", "exitDur": 0.3 },

    { "type": "rect", "x": 90, "y": 570, "w": 725, "h": 76, "radius": 8, "color": "var(--accent)",
      "start": 18.95, "duration": 3.55, "anim": "wipe-right", "enterDur": 0.7, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo2}}", "x": 118, "y": 589, "w": 480, "size": 38, "weight": 700,
      "font": "mono", "color": "var(--bg)", "anim": "fade", "enterDur": 0.4,
      "start": 19.35, "duration": 3.15, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo2n}}", "x": 515, "y": 589, "w": 272, "align": "right", "size": 38,
      "weight": 700, "font": "mono", "color": "var(--bg)", "anim": "fade", "enterDur": 0.4,
      "start": 19.35, "duration": 3.15, "out": "fade", "exitDur": 0.3 },

    { "_": "the third bar is the same treatment, not a dimmer one: an `accent-dim` fill put 32px text at 1.2:1 and the audit caught it.",
      "type": "rect", "x": 90, "y": 680, "w": 320, "h": 76, "radius": 8, "color": "var(--accent)",
      "start": 19.1, "duration": 3.4, "anim": "wipe-right", "enterDur": 0.7, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo3}}", "x": 118, "y": 699, "w": 280, "size": 38, "weight": 700,
      "font": "mono", "color": "var(--bg)", "anim": "fade", "enterDur": 0.4,
      "start": 19.5, "duration": 3.0, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "{{repo3n}}", "x": 436, "y": 699, "w": 220, "size": 38,
      "weight": 700, "font": "mono", "color": "var(--text-2)", "anim": "fade", "enterDur": 0.4,
      "start": 19.5, "duration": 3.0, "out": "fade", "exitDur": 0.3 },
    { "type": "text", "text": "commits, by repository", "x": 90, "y": 900, "w": 900, "size": 36,
      "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 19.8, "duration": 2.7, "out": "fade", "exitDur": 0.3 },

    { "_": "BEAT 6, the payoff. Every number so far has been large and got larger. This one is SMALL, and it is the one that left the building.",
      "type": "count", "from": 0, "to": {{commits}}, "x": 90, "y": 280, "w": 900,
      "size": 120, "weight": 800, "color": "var(--text-2)", "ls": "-0.03em",
      "countStart": 0.2, "countDur": 1.2, "ease": "easeOutExpo",
      "start": 22.7, "duration": 6.0, "anim": "fade", "enterDur": 0.3 },
    { "type": "text", "text": "commits this year.", "x": 90, "y": 430, "w": 900, "size": 40,
      "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.4,
      "start": 23.0, "duration": 5.7 },
    { "type": "text", "text": "The one that travelled furthest", "x": 90, "y": 580, "w": 900, "size": 48,
      "weight": 600, "color": "var(--text)", "anim": "rise", "enterDur": 0.5,
      "start": 24.2, "duration": 4.5 },
    { "type": "text", "text": "was <b>{{faradds}} lines.</b>", "x": 90, "y": 670, "w": 900, "size": 110,
      "weight": 800, "color": "var(--accent)", "split": "char", "preset": "up", "each": 0.4, "stagger": 0.035,
      "start": 25.0, "duration": 3.7 },
    { "type": "text", "text": "{{farowner}}/{{farrepo}} · {{farstars}} stars · merged {{farwhen}}",
      "x": 90, "y": 850, "w": 900, "size": 34, "font": "mono", "color": "var(--text-2)",
      "anim": "fade", "enterDur": 0.5, "start": 25.9, "duration": 2.8 },
    { "type": "text", "text": "@{{login}} · {{from}} to {{to}}", "x": 90, "y": 1700, "w": 900, "size": 28,
      "font": "mono", "color": "var(--dim)", "anim": "fade", "enterDur": 0.5,
      "start": 26.4, "duration": 2.3 }
  ]
}
