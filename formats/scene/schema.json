{
  "title": "Hyperscene (open canvas)",
  "description": "Generic data-driven composition — the JSON is the video. Layers (text/image/component/rect) with timed windows, kinetic splits, the cut kit (whip/punch/iris/...), WebGL shader stings (flash/burn/leak/grain/dissolve), theme bg-preset windows on canvas, global camera, captions.",
  "note": "data.theme drives palette/fonts/bg colours. Coordinates are px in the chosen orientation space (1080×1920 portrait, 1920×1080 landscape).",
  "fields": {
    "orientation": {
      "type": "string",
      "label": "Orientation",
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "aspect": {
      "type": "string",
      "label": "Canvas aspect (overrides orientation). CLI --aspect a,b,c renders multiple in one pass.",
      "enum": ["16:9", "9:16", "1:1", "4:5", "4:3"]
    },
    "duration": {
      "type": "number",
      "label": "Total duration (s)",
      "min": 0.5,
      "max": 120
    },
    "fps": {
      "type": "number",
      "label": "Frame rate (default 30; use 60 for smoother fast motion)",
      "enum": [24, 30, 60]
    },
    "captionMode": {
      "type": "string",
      "label": "Caption style",
      "enum": [
        "sentence",
        "word",
        "pop"
      ]
    },
    "bg": {
      "type": "array",
      "label": "Background windows (canvas, theme palette)",
      "item": {
        "preset": {
          "type": "string",
          "label": "bgPreset name",
          "enum": [
            "paper",
            "paperShapes",
            "paperDots",
            "soft",
            "accent",
            "ink",
            "dotmatrix",
            "aurora",
            "mesh",
            "constellation",
            "spotlight",
            "brandglow",
            "plain",
            "accentPlain",
            "deep",
            "dark"
          ]
        },
        "from": {
          "type": "number",
          "label": "Window start (s)"
        },
        "to": {
          "type": "number",
          "label": "Window end (s)"
        },
        "value": {
          "type": "string",
          "label": "Force light/dark treatment",
          "enum": [
            "light",
            "dark"
          ]
        },
        "opts": {
          "type": "object",
          "label": "Per-video tuning: { intensity, dotAlpha, spacing, drift, grain }"
        },
        "seed": {
          "type": "number",
          "label": "Vary the preset's positions/phase (default = hash of theme+preset, so brands differ)"
        },
        "use": {
          "type": "string",
          "label": "use:\"theme\" → pull the brand’s own authored backdrop (themes/<name>.json bgDefault)"
        }
      }
    },
    "stings": {
      "type": "array",
      "label": "Shader boundary effects",
      "item": {
        "t": {
          "type": "number",
          "label": "Center time (s)",
          "required": true
        },
        "fx": {
          "type": "string",
          "label": "Effect",
          "required": true,
          "enum": [
            "flash",
            "burn",
            "leak",
            "grain",
            "dissolve",
            "ink",
            "glitch",
            "streak",
            "pixel",
            "confetti",
            "ripple",
            "scan",
            "warp",
            "bokeh",
            "wipe",
            "circle",
            "blinds",
            "squares",
            "pinwheel",
            "doors",
            "polka",
            "swirl"
          ]
        },
        "dur": {
          "type": "number",
          "label": "Effect span (s)",
          "min": 0.3,
          "max": 3
        },
        "seed": {
          "type": "number",
          "label": "Noise seed"
        },
        "color": {
          "type": "string",
          "label": "Tint hex (recolours the effect; omit for native colours)"
        },
        "intensity": {
          "type": "number",
          "label": "Strength multiplier (1 = default)"
        },
        "colors": {
          "type": "array",
          "label": "leak: up to 4 hex colours the leak is built from (seed only arranges them)"
        }
      }
    },
    "camera": {
      "type": "array",
      "label": "Global camera keyframes",
      "item": {
        "t": {
          "type": "number",
          "label": "Time (s)",
          "required": true
        },
        "s": {
          "type": "number",
          "label": "Scale"
        },
        "x": {
          "type": "number",
          "label": "Pan X (px)"
        },
        "y": {
          "type": "number",
          "label": "Pan Y (px)"
        }
      }
    },
    "layers": {
      "type": "array",
      "label": "Layers",
      "required": true,
      "minItems": 1,
      "maxItems": 120,
      "item": {
        "type": {
          "type": "string",
          "label": "Layer type",
          "enum": [
            "text",
            "image",
            "component",
            "rect",
            "count",
            "group",
            "glow",
            "board",
            "doc",
            "html",
            "clip",
            "cursor",
            "shader",
            "lottie"
          ]
        },
        "shader": {
          "type": "string",
          "label": "shader: ambient WebGL effect (flow/aurora/plasma/drift/mist) — smooth colour field behind content. Tune with speed · intensity · colors · seed",
          "enum": [
            "flow",
            "aurora",
            "plasma",
            "drift",
            "mist"
          ]
        },
        "html": {
          "type": "string",
          "label": "html: raw hand-authored HTML/CSS for the layer (static; <script> stripped)"
        },
        "speed": {
          "type": "number",
          "label": "clip: playback rate multiplier (1 = realtime; 0.5 = half speed)"
        },
        "typing": {
          "type": "number",
          "label": "text: type it out at N chars/sec (true = 24) with a blinking caret"
        },
        "caret": {
          "type": "boolean",
          "label": "typing: show the blinking caret (default true)"
        },
        "caretHold": {
          "type": "boolean",
          "label": "typing: keep the caret after the text finishes"
        },
        "path": {
          "type": "array",
          "label": "cursor: [{t,x,y,ease}] keyframes the pointer follows (x,y = absolute screen px when no layer x/y is set; relative to x/y if it is)"
        },
        "clicks": {
          "type": "array",
          "label": "cursor: [t, …] local times to fire a click (dip + ripple)"
        },
        "rippleColor": {
          "type": "string",
          "label": "cursor: click-ripple ring colour"
        },
        "filename": {
          "type": "string",
          "label": "doc: filename shown in the card header (e.g. creed.md)"
        },
        "diff": {
          "type": "string",
          "label": "doc: diff chip in the header (e.g. +18 -0)"
        },
        "blocks": {
          "type": "array",
          "label": "doc: content blocks — {h,accent} heading · {body} mono lines · {code} · {bullets:[]}"
        },
        "nameSize": {
          "type": "number",
          "label": "doc: filename / diff-chip font px (default 30)"
        },
        "hSize": {
          "type": "number",
          "label": "doc: block-heading font px (default 40)"
        },
        "bodySize": {
          "type": "number",
          "label": "doc: body / code / bullet font px (default 30)"
        },
        "blockGap": {
          "type": "number",
          "label": "doc: vertical gap above each heading block (default 22)"
        },
        "text": {
          "type": "string",
          "label": "Text (may use <b>/<em>)"
        },
        "src": {
          "type": "string",
          "label": "Image / captured-component path"
        },
        "x": {
          "type": "number|string",
          "label": "Left: px number, or relative \"50%\" / \"50%-40\" / center / left / right (resolved per aspect)"
        },
        "y": {
          "type": "number|string",
          "label": "Top: px number, or relative \"50%\" / center / top / bottom (resolved per aspect)"
        },
        "w": {
          "type": "number|string",
          "label": "Width: px number or \"50%\" of canvas"
        },
        "h": {
          "type": "number|string",
          "label": "Height: px number or \"50%\" of canvas"
        },
        "pin": {
          "type": "string",
          "label": "Canvas-relative placement: edge/center (center = optical), or a rule-of-thirds power point",
          "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right",
            "thirds-tl", "thirds-tr", "thirds-bl", "thirds-br", "thirds-t", "thirds-b", "thirds-l", "thirds-r"]
        },
        "col": {
          "type": "number|string",
          "label": "12-col grid placement: \"3\" (one column) or \"2-7\" (a span) → sets x + w"
        },
        "cols": {
          "type": "number",
          "label": "Grid column count (default 12)"
        },
        "gutter": {
          "type": "number",
          "label": "Grid gutter px (default = half the safe inset)"
        },
        "ls": {
          "type": "string",
          "label": "Letter-spacing (e.g. \"-0.03em\"); unset = auto optical tracking by size"
        },
        "raw": {
          "type": "boolean",
          "label": "Opt out of the micro-typography pass (tracking/balance/kerning)"
        },
        "align": {
          "type": "string",
          "label": "Text align",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "font": {
          "type": "string",
          "label": "Face",
          "enum": [
            "sans",
            "serif",
            "mono"
          ]
        },
        "italic": {
          "type": "boolean",
          "label": "Force italic on/off (default: serif is italic, others upright). italic:false = upright serif."
        },
        "size": {
          "type": "number",
          "label": "Font size (px)",
          "min": 18,
          "max": 260
        },
        "weight": {
          "type": "number",
          "label": "Font weight",
          "min": 100,
          "max": 900
        },
        "color": {
          "type": "string",
          "label": "Glow color / text color"
        },
        "emColor": {
          "type": "string",
          "label": "<b> emphasis colour (default: brand accent, or inherit over an accent bg)"
        },
        "tracking": {
          "type": "string",
          "label": "Letter-spacing"
        },
        "fit": {
          "type": "boolean",
          "label": "Auto-size text down to fit w"
        },
        "bg": {
          "type": "string",
          "label": "Fill (rect)"
        },
        "radius": {
          "type": "number",
          "label": "Corner radius (rect/ken-image)"
        },
        "border": {
          "type": "string",
          "label": "Border (rect)"
        },
        "shadow": {
          "type": "boolean",
          "label": "Soft shadow (rect)"
        },
        "start": {
          "label": "Window start: seconds, or relative \"otherId+0.5\" / \"otherId.end-0.2\""
        },
        "duration": {
          "type": "number",
          "label": "Window length (s)"
        },
        "track": {
          "type": "number",
          "label": "z-order track"
        },
        "anim": {
          "type": "string",
          "label": "driveClips enter anim (fade/rise/pop/slideL/...)"
        },
        "out": {
          "type": "string",
          "label": "driveClips exit anim"
        },
        "exitDur": {
          "type": "number",
          "label": "Exit window (s; 0 = hold to end)"
        },
        "enterDur": {
          "type": "number",
          "label": "Enter window (s, cut layers)"
        },
        "cut": {
          "type": "string",
          "label": "Cut-kit presentation",
          "enum": [
            "fade",
            "slide",
            "whip",
            "punch",
            "wipe",
            "iris",
            "clock",
            "flip",
            "rise",
            "blur",
            "zoom",
            "cube",
            "barn",
            "softwipe",
            "softiris",
            "squeeze",
            "roll",
            "letterbox",
            "drop",
            "jitter",
            "blinds",
            "skewWhip",
            "spin",
            "collapse",
            "riseBlur"
          ]
        },
        "dir": {
          "type": "string",
          "label": "Cut direction",
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ]
        },
        "dist": {
          "type": "number",
          "label": "Cut travel (px)"
        },
        "cutTiming": {
          "type": "string",
          "label": "Cut timing curve",
          "enum": [
            "linear",
            "smooth",
            "out",
            "snappy",
            "pop",
            "rush",
            "brake",
            "ramp"
          ]
        },
        "cx": {
          "type": "number",
          "label": "Iris/soft-iris centre X (0-100%)"
        },
        "cy": {
          "type": "number",
          "label": "Iris/soft-iris centre Y (0-100%)"
        },
        "split": {
          "type": "string",
          "label": "Kinetic split ('path' = SVG strokes, for the `draw` preset)",
          "enum": [
            "char",
            "word",
            "line",
            "path"
          ]
        },
        "preset": {
          "type": "string",
          "label": "Kinetic preset (up/down/type/scale/blur/bounce/slide/wave/flip/fall/elastic/skew/focus/decode/tilt/stretch/gradient/highlight/underline/shadow/riseClip)"
        },
        "stagger": {
          "type": "number",
          "label": "Per-unit delay (s)"
        },
        "each": {
          "type": "number",
          "label": "Per-unit duration (s)"
        },
        "loop": {
          "type": "boolean",
          "label": "Loop the kinetic preset"
        },
        "presetOpts": {
          "type": "object",
          "label": "Per-preset knobs (e.g. gradient c1/c2, highlight color, blur px, tilt deg, wave amp, spring bounce/settle)"
        },
        "filter": {
          "type": "string",
          "label": "CSS filter"
        },
        "mask": {
          "type": "string",
          "label": "CSS mask-image"
        },
        "critical": {
          "type": "boolean",
          "label": "Force include/exclude from layout audit"
        },
        "ken": {
          "label": "Ken Burns zoom (image): true or {from,to,fx,fy}"
        },
        "edgeFade": {
          "label": "Image: fade the LEFT+RIGHT edges into the bg (white by default). true or fade-width %"
        },
        "edgeFadeColor": {
          "type": "string",
          "label": "Image: colour the edgeFade dissolves into (default #ffffff; set to the bg for dark scenes)"
        },
        "from": {
          "type": "number",
          "label": "Count start value (count)"
        },
        "to": {
          "type": "number",
          "label": "Count end value (count)"
        },
        "decimals": {
          "type": "number",
          "label": "Decimal places (count)",
          "min": 0,
          "max": 3
        },
        "prefix": {
          "type": "string",
          "label": "Count prefix (e.g. +, $)"
        },
        "suffix": {
          "type": "string",
          "label": "Count suffix (e.g. %, s)"
        },
        "unit": {
          "type": "string",
          "label": "Count unit appended after the number (e.g. %, k, $B); raw ≥1e6 auto-compacts (2.5B) when no unit"
        },
        "countStart": {
          "type": "number",
          "label": "Count begins (s into window)"
        },
        "countDur": {
          "type": "number",
          "label": "Count duration (s)"
        },
        "ease": {
          "type": "string",
          "label": "Count easing (EASINGS name, e.g. ramp)"
        },
        "id": {
          "type": "string",
          "label": "Layer id (anchor target)"
        },
        "anchor": {
          "type": "string",
          "label": "Position relative to layer with this id"
        },
        "at": {
          "type": "string",
          "label": "Placement",
          "enum": [
            "below",
            "below-center",
            "above",
            "above-center",
            "right",
            "left"
          ]
        },
        "dx": {
          "type": "number",
          "label": "Anchor offset x (px)"
        },
        "dy": {
          "type": "number",
          "label": "Anchor offset y (px)"
        },
        "direction": {
          "type": "string",
          "label": "Group flow",
          "enum": [
            "row",
            "column"
          ]
        },
        "gap": {
          "type": "number",
          "label": "Group gap (px)"
        },
        "pad": {
          "label": "Padding (px or CSS string) — groups and text chips"
        },
        "justify": {
          "type": "string",
          "label": "Group justify-content"
        },
        "children": {
          "type": "array",
          "label": "Group children — text/image/count, or a nested group (layout by flow)",
          "item": {
            "type": {
              "type": "string",
              "label": "Child type",
              "enum": [
                "text",
                "image",
                "count",
                "group"
              ]
            }
          }
        },
        "layout": {
          "type": "string",
          "label": "Group layout: row | column | grid",
          "enum": [
            "row",
            "column",
            "grid"
          ]
        },
        "gridCols": {
          "type": "number",
          "label": "Grid column count (layout:grid)",
          "min": 1,
          "max": 8
        },
        "colw": {
          "type": "number",
          "label": "Grid column width in px (layout:grid; default 1fr)"
        },
        "fitH": {
          "type": "number",
          "label": "Max height (px) for multi-line auto-fit (with fit+w) — binary-search font to fit"
        },
        "maxLines": {
          "type": "number",
          "label": "Auto-fit safety: shrink a headline that wraps past this many lines (default 5)"
        },
        "items": {
          "type": "string",
          "label": "align-items for a group (flex/grid): flex-start | center | flex-end | stretch | baseline"
        },
        "align2": {
          "type": "string",
          "label": "DEPRECATED alias of `items` (align-items) — use `items`"
        },
        "wrap": {
          "type": "boolean",
          "label": "Flex-wrap the row"
        },
        "colGap": {
          "type": "number",
          "label": "Grid column gap (px)"
        },
        "rowGap": {
          "type": "number",
          "label": "Grid row gap (px)"
        },
        "grow": {
          "type": "number",
          "label": "Child flex-grow (in a group)"
        },
        "basis": {
          "label": "Child flex-basis (px or CSS length)"
        },
        "motion": {
          "type": "array",
          "label": "Keyframe track — element choreography (pure in t). Offsets on the base position.",
          "item": {
            "t": {
              "type": "number",
              "label": "Seconds from layer start"
            },
            "x": {
              "type": "number",
              "label": "X offset (px)"
            },
            "y": {
              "type": "number",
              "label": "Y offset (px)"
            },
            "scale": {
              "type": "number",
              "label": "Scale multiplier"
            },
            "rot": {
              "type": "number",
              "label": "Rotation (deg)"
            },
            "opacity": {
              "type": "number",
              "label": "Opacity multiplier"
            },
            "ease": {
              "type": "string",
              "label": "Easing name (incl. spring, spring-bouncy, spring-stiff)"
            }
          }
        },
        "motionBlur": {
          "label": "Velocity motion blur on this layer's motion track (streak on fast moves; crisp when settled). true = half-shutter; a 0..1 number sets strength. Needs a motion track."
        },
        "elevation": {
          "type": "number",
          "label": "Physical depth 1–4 (ring + lit edge + stacked shadows)",
          "min": 1,
          "max": 4
        },
        "on": {
          "type": "string",
          "label": "Elevation surface variant",
          "enum": [
            "light",
            "dark"
          ]
        },
        "glow": {
          "label": "Ambient glow: hex color, or true for theme accent"
        },
        "intensity": {
          "type": "number",
          "label": "Effect strength: glow opacity (0.05-0.6) · shader visibility (up to 1)",
          "min": 0.05,
          "max": 1
        },
        "beam": {
          "type": "string",
          "label": "Glow becomes a directional beam",
          "enum": [
            "right",
            "left",
            "up",
            "down"
          ]
        },
        "fade": {
          "type": "string",
          "label": "Static edge fade (exclusive with cut)",
          "enum": [
            "right",
            "left",
            "top",
            "bottom",
            "edges"
          ]
        },
        "reflect": {
          "label": "Floor reflection: true or opacity 0.05–0.3"
        },
        "cols": {
          "type": "array",
          "label": "Board columns (≤4): {title, count, cards:[{id,title,labels:[{t,c}]}] ≤5}",
          "item": {
            "title": {
              "type": "string",
              "label": "Column title"
            }
          }
        },
        "headSize": {
          "type": "number",
          "label": "Board column-header px"
        },
        "cardSize": {
          "type": "number",
          "label": "Board card base px"
        },
        "part": {
          "type": "string",
          "label": "Scene part name (capture-scene JSONs)"
        }
      }
    },
    "captions": {
      "type": "array",
      "label": "Caption windows",
      "item": {
        "t0": {
          "type": "number",
          "label": "Start (s)",
          "required": true
        },
        "t1": {
          "type": "number",
          "label": "End (s)",
          "required": true
        },
        "text": {
          "type": "string",
          "label": "Caption text",
          "required": true
        }
      }
    }
  }
}
