{
  "module": "scene",
  "orientation": "landscape",
  "theme": "argus",
  "duration": 11,
  "audio": {
    "silent": true,
    "_why": "a probe for the followCursor camera, not a film: the only thing being judged is whether the frame reads as chasing the pointer"
  },
  "bg": [
    {
      "preset": "paper",
      "from": 0,
      "to": 11
    }
  ],
  "cameraMove": {
    "move": "followCursor",
    "cursor": "ptr"
  },
  "layers": [
    {
      "id": "sidebar-panel",
      "type": "html",
      "x": 260,
      "y": 180,
      "w": 1400,
      "h": 720,
      "bg": "var(--surface)",
      "border": "1px solid var(--line)",
      "radius": 20,
      "shadow": true,
      "start": 0,
      "duration": 11,
      "anim": "fade",
      "exitDur": 0,
      "html": "<div style=\"position:relative;width:1400px;height:720px\"><div style=\"position:absolute;left:0;top:0;width:300px;height:720px;background:var(--surface-2)\"></div><div data-part style=\"position:absolute;left:40px;top:46px;font:600 26px var(--font-sans);color:var(--ink)\">Workspace</div><div data-part style=\"position:absolute;left:40px;top:120px;font:400 22px var(--font-sans);color:var(--dim)\">Drafts</div><div data-part style=\"position:absolute;left:40px;top:168px;font:400 22px var(--font-sans);color:var(--dim)\">Published</div><div data-part style=\"position:absolute;left:40px;top:216px;font:400 22px var(--font-sans);color:var(--dim)\">Archive</div></div>",
      "parts": [
        {
          "select": "[data-part]",
          "anim": "fadeUp",
          "each": 0.4,
          "stagger": 0.05,
          "delay": 0.1
        }
      ]
    },
    {
      "id": "card-row",
      "type": "html",
      "x": 620,
      "y": 260,
      "w": 980,
      "h": 200,
      "start": 0,
      "duration": 11,
      "anim": "none",
      "enterDur": 0,
      "exitDur": 0,
      "html": "<div style=\"position:relative;width:980px;height:200px\"><div class=\"card\" style=\"position:absolute;left:0px;top:0;width:300px;height:200px;border-radius:14px;background:var(--surface);border:1px solid var(--line)\"><span style=\"position:absolute;left:30px;top:140px;font:500 24px var(--font-sans);color:var(--ink)\">Pricing page</span></div><div class=\"card\" style=\"position:absolute;left:340px;top:0;width:300px;height:200px;border-radius:14px;background:var(--surface);border:1px solid var(--line)\"><span style=\"position:absolute;left:30px;top:140px;font:500 24px var(--font-sans);color:var(--ink)\">Changelog</span></div><div class=\"card\" style=\"position:absolute;left:680px;top:0;width:300px;height:200px;border-radius:14px;background:var(--surface);border:1px solid var(--line)\"><span style=\"position:absolute;left:30px;top:140px;font:500 24px var(--font-sans);color:var(--ink)\">Careers</span></div></div>",
      "parts": [
        {
          "select": ".card",
          "anim": "popIn",
          "each": 0.35,
          "stagger": 0.1,
          "delay": 0.2,
          "out": false
        }
      ]
    },
    {
      "type": "rect",
      "x": 620,
      "y": 260,
      "w": 300,
      "h": 200,
      "radius": 14,
      "bg": "rgba(37,99,235,0.10)",
