  "authoring": {
    "allow": [
      "unreadable-hold",
      "aphoristic-cadence"
    ],
    "_why": {
      "unreadable-hold": "the end card subtitle names the whole recipe (backdrop-filter, one SVG displacement map, three indices of refraction) and that IS the payoff of the film. The end card is 3.5s, so no honest duration reaches the reading wall for nine words, and cutting it to three would delete the answer the other sixteen seconds were asking for. Every other line was cut instead.",
      "aphoristic-cadence": "\"No 3D. No plugin.\" is a factual exclusion, not manufactured contrast: the film loads no 3D scene and no plugin, and the line under it names exactly what it does load."
    }
  }
