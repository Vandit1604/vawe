    "b": { "type": "object", "label": "Side B", "item": { "name": { "type": "string", "label": "Name" } } },
    "overall": { "type": "string", "label": "Overall winner ('a' or 'b')" },
    "fields": { "type": "array", "label": "Spec rows", "item": {
      "label": { "type": "string", "label": "Row label" },
      "valA": { "type": "number", "label": "A value" }, "valB": { "type": "number", "label": "B value" },
      "unit": { "type": "string", "label": "Unit" }, "winner": { "type": "string", "label": "Row winner ('a'/'b')" } } }
