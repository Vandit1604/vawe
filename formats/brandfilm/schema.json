{
  "title": "Brandfilm (narrative reel)",
  "description": "Landscape long-form brand film. Theme-driven; scenes[] of type title/statement/steps/stats/features/quote/split/cta with per-scene bg + value. The payoff stat belongs at ~80–90%.",
  "note": "data.theme (string name or inline object) sets palette/fonts/motion — validated separately by validateTheme. data.brand = watermark favicon path.",
  "fields": {
    "orientation": { "type": "string", "label": "Orientation", "enum": ["portrait", "landscape"] },
    "brand": { "type": "string", "label": "Watermark favicon path" },
    "scenes": { "type": "array", "label": "Scenes", "required": true, "minItems": 2, "maxItems": 24, "item": {
      "type": { "type": "string", "label": "Scene type", "required": true, "enum": ["title", "statement", "steps", "stats", "features", "quote", "split", "cta"] },
      "dur": { "type": "number", "label": "Duration (s)", "min": 2, "max": 10 },
      "bg": { "type": "string", "label": "Background preset (plain by default; texture on hook/CTA only)" },
      "value": { "type": "string", "label": "Force light/dark treatment", "enum": ["light", "dark"] },
      "eyebrow": { "type": "string", "label": "Eyebrow (title/split)" },
      "title": { "type": "string", "label": "Headline (title/steps/features/split)" },
      "sub": { "type": "string", "label": "Subline (title/split)" },
      "text": { "type": "string", "label": "Statement / quote text" },
      "serif": { "type": "boolean", "label": "Serif face (statement)" },
      "cite": { "type": "string", "label": "Quote attribution" },
      "image": { "type": "string", "label": "Image path (split)" },
      "steps": { "type": "array", "label": "Step cards (steps)", "minItems": 2, "maxItems": 5, "item": {
        "n": { "type": "string", "label": "Number chip (default 01…)" },
        "h": { "type": "string", "label": "Step heading", "required": true },
        "d": { "type": "string", "label": "Step description" } } },
      "stats": { "type": "array", "label": "Stat count-ups (stats)", "minItems": 1, "maxItems": 4, "item": {
        "v": { "type": "number", "label": "Value", "required": true },
        "l": { "type": "string", "label": "Label", "required": true },
        "compact": { "type": "boolean", "label": "Compact big numbers (2.5M)" },
        "suffix": { "type": "string", "label": "Suffix (%, ×, +)" } } },
      "items": { "type": "array", "label": "Feature cards (features)", "minItems": 2, "maxItems": 6, "item": {
        "h": { "type": "string", "label": "Feature heading", "required": true },
        "d": { "type": "string", "label": "Feature description" } } },
      "cta": { "type": "string", "label": "CTA headline (cta)" },
      "url": { "type": "string", "label": "URL (cta)" },
      "logo": { "type": "string", "label": "Logo path (cta)" }
    } }
  }
}
