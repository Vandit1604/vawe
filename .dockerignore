# The site image needs: scripts/ core/ themes/ formats/scene/{scene.html,schema.json}
# assets/{icons,vendor} and site/. Everything else is render-only or local build output.
**/node_modules
**/.next
**/.source
.git
.claude

# render artifacts + render-only assets (the browser never touches these; Go mixes audio at encode)
out
assets/music
assets/sfx
assets/fonts
assets/brands
assets/plinth
assets/ransom
assets/ransom-src
assets/flags
# ...except the handful of real marks the playable scenes reach for (144K of brands' 59M).
# scripts/site/site-engine.mjs derives the list from the scenes themselves and FAILS the build if
# one is absent, so these negations are what let it find them: without them the build context has
# no assets/brands at all and every one 404s in production, which is exactly what happened.
!assets/brands/creed/agents
!assets/brands/creed/brandmark.svg
!assets/brands/argus/mascot.png
!assets/brands/linear/icon.png

# not part of the site image
# NB: docs-site IS part of it — the image runs the docs app on 3001 and the site rewrites /docs to
# it. It was listed here, so the build could not see it and /docs could never have worked in prod.
# Its node_modules/.next/.source are already covered by the ** rules above; .source in particular
# must stay ignored so the image regenerates it from content/ rather than shipping a stale copy.
bin
verify
dna
blocks
sims
scratchpad
*.mp4
*.wav

# offline bake output + generated fixtures: 72M of PNGs that no COPY in the Dockerfile mentions.
# Both are gitignored, so they are invisible in the repo but NOT in the build context, which is the
# working tree. They were being shipped to the daemon on every build for nothing.
assets/baked
assets/gen

# generated by scripts/site-engine.mjs during the build (never ship a stale copy)
site/public/core
site/public/themes
site/public/engine
site/public/formats
site/public/scripts
