# The site image needs: scripts/ core/ themes/ formats/scene/{scene.html,schema.json}
# engine/assets/{icons,vendor} and site/. Everything else is render-only or local build output.
**/node_modules
**/.next
**/.source
.git
.claude

# render artifacts + render-only assets (the browser never touches these; Go mixes audio at encode)
engine/out
engine/assets/music
engine/assets/sfx
engine/assets/fonts
engine/assets/brands
engine/assets/plinth
engine/assets/flags

# not part of the site image
docs-site
bin
verify
dna
blocks
*.mp4
*.wav

# generated by scripts/site-engine.mjs during the build (never ship a stale copy)
site/public/core
site/public/themes
site/public/engine
site/public/formats
site/public/scripts
