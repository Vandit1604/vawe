+# make bench [FILMS=a.json,b.json] [RUNS=3] [WRITE=docs/PERF-BASELINE.md]: how long a render takes,
+# and where the time goes. Three tracked films, one discarded warm-up plus three timed runs each,
+# median and spread, split into boot / capture / encode / audio / mux. It measures and changes nothing.
+# RUN IT ON A QUIET MACHINE: it reads the load average around every run and refuses to WRITE a baseline
+# taken while something else was on the cores, because a neighbour's render reads exactly like a
+# regression. The baseline it writes is what `docs/PERF-BASELINE.md` is for.
+bench: build
+	@node scripts/dev/render-bench.mjs $(if $(FILMS),--films $(FILMS)) $(if $(RUNS),--runs $(RUNS)) $(if $(WRITE),--write $(WRITE)) $(if $(VAWEFLAGS),-- $(VAWEFLAGS))
+
