    "html": "<div style=\"position:relative;box-sizing:border-box;width:1040px;height:480px;background:var(--surface);border:1.5px solid var(--line);border-radius:20px\"><div data-part-open style=\"position:absolute;left:60px;top:60px;font:650 44px var(--font-sans);color:var(--text)\">Weekly report</div><div data-part-open style=\"position:absolute;left:60px;top:130px;font:500 30px var(--font-sans);color:var(--text-2)\">18 rows ready.</div><div data-part-open style=\"position:absolute;left:380px;top:340px;width:220px;height:64px;border-radius:12px;background:var(--accent);display:flex;align-items:center;justify-content:center\"><span style=\"font:650 28px var(--font-sans);color:var(--on-accent)\">Export</span></div><div data-part-done style=\"position:absolute;left:380px;top:240px;width:220px;text-align:center;font:650 30px var(--font-sans);color:var(--up)\">Exported.</div></div>",
    "parts": [
      { "select": "[data-part-open]", "anim": "riseIn", "each": 0.35, "stagger": 0.12, "delay": 0.15 },
      { "select": "[data-part-done]", "anim": "popIn", "each": 0.3, "delay": 2.9, "out": true, "exitDur": 0.2 }
    ]
  },

  { "type": "cursor", "path": [
