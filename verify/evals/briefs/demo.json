      { "t": 1.0, "x": 800, "y": 560, "ease": "easeInOutSine" },
      { "t": 1.7, "x": 928, "y": 630, "ease": "easeOutCubic" }
    ], "clicks": [1.7], "start": 3.7, "duration": 2.4, "anim": "fade", "enterDur": 0.3, "out": "fade", "exitDur": 0.3 },

  { "type": "text", "text": "The click. The response. The proof.", "size": 64, "weight": 640, "w": 1500, "x": 160, "y": 420, "start": 7.4, "duration": 2.4, "anim": "slide-up", "enterDur": 0.5, "out": "fade", "exitDur": 0 },
  { "type": "text", "text": "vawe.dev", "size": 40, "weight": 600, "color": "var(--accent)", "font": "mono", "x": 160, "y": 540, "start": 8.0, "duration": 1.8, "anim": "fade", "enterDur": 0.4, "out": "fade", "exitDur": 0 },

  { "type": "rect", "w": 10, "h": 10, "radius": 5, "x": 60, "y": 60, "fill": "var(--accent)", "start": 0, "duration": 10, "acrossBeats": true,
    "motion": [
      { "t": 0, "x": 0, "y": 0 },
      { "t": 3.7, "x": 0, "y": 40, "ease": "easeInOutSine" },
