{
  "module": "scene",
  "authoringNote": "CAPTURE SUBJECT for formats/scene/playhead.json. This is a real, renderable draft film whose timeline is photographed as the hero surface of the recreation. Two things are deliberate and load-bearing: (1) it declares NO cuts, so `sceneUnits` never turns on and no layer's authored duration is rewritten, which is what lets a dead-air hole draw as an undisputed hazard band; (2) its fourteen layers are SIX different types, so the lane stack reads as a structure rather than as one block of identical bars.",
  "aspect": "16:9",
  "theme": "vawe",
  "duration": 16,
  "audio": {
    "silent": true
  },
  "authoring": {
    "allow": [
      "no-continuous-object",
      "plain-slideshow",
      "ends-on-nothing"
    ]
  },
  "bg": [
    {
      "t": 0,
      "preset": "plain"
    }
  ],
  "layers": [
    {
      "id": "title",
      "type": "text",
      "text": "A draft, mid authoring.",
      "x": 140,
      "y": 300,
      "w": 1400,
      "align": "left",
      "size": 96,
      "weight": 600,
      "color": "var(--text)",
      "start": 0.2,
      "duration": 2.4
    },
    {
      "id": "sub",
      "type": "text",
      "text": "Fourteen layers on one clock.",
      "x": 140,
      "y": 440,
      "w": 1400,
      "align": "left",
      "size": 52,
      "weight": 400,
      "color": "var(--dim)",
      "start": 0.9,
      "duration": 2.2
    },
    {
      "id": "rule",
      "type": "rect",
      "x": 140,
      "y": 540,
      "w": 620,
      "h": 6,
      "fill": "var(--accent)",
      "start": 1.4,
      "duration": 3.1
    },
    {
      "id": "panel",
      "type": "rect",
      "x": 140,
      "y": 240,
      "w": 900,
      "h": 560,
      "radius": 20,
      "fill": "var(--surface2)",
      "start": 3,
      "duration": 4.4
    },
    {
      "id": "panel-head",
      "type": "text",
      "text": "Coverage",
      "x": 190,
      "y": 300,
      "w": 800,
      "align": "left",
      "size": 44,
      "weight": 600,
      "color": "var(--text)",
      "start": 3.3,
      "duration": 4
    },
    {
      "id": "stat",
      "type": "count",
      "from": 0,
