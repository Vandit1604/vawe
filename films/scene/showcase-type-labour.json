  "allow": [
   "numbered-section-markers",
   "static-bg"
  ],
  "_why": {
   "numbered-section-markers": "the numbers ARE the content: the reel is ordered by ascending After Effects labour, so 01..09 is the argument itself, not scaffolding above unrelated sections. This is the exemption the rule names.",
   "static-bg": "see bg[0]._why. A motion reference must hold its ground still or the reader cannot tell the effect from the backdrop. The film does turn its backdrop once, at the payoff, where nothing is being compared any more."
  }
 },
