{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "screenSwap.slide",
  "type": "vawe:block",
  "title": "screenSwap.slide",
  "description": "screen change that reads as travel · enters right, leaves left",
  "tags": [
    "screenSwap"
  ],
  "dimensions": {
    "width": 504,
    "height": 115
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "screenSwap.slide",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 460,
      "hold": 2.4,
      "transition": "slide",
      "screens": [
        {
          "block": "settingsRow",
          "props": {
            "w": 460,
            "label": "Sync across devices",
            "sub": "Keep every draft current everywhere",
            "control": "toggle",
            "value": true
          }
        },
        {
          "block": "settingsRow",
          "props": {
            "w": 460,
            "label": "Notifications",
            "sub": "Only for shared workspaces",
            "control": "value",
            "value": "Mentions"
          }
        },
        {
          "block": "settingsRow",
          "props": {
            "w": 460,
            "label": "Appearance",
            "sub": "Match the system theme",
            "control": "chevron"
          }
        }
      ]
    },
    "props": [
      "x",
      "y",
      "w",
      "screens",
      "hold",
      "overlap",
      "transition",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/screenSwap.slide.json",
      "url": "https://vawe.dev/assets/blocks/screenSwap.slide.json",
      "target": "films/scene/screenSwap.slide.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/screenSwap.slide.png"
  }
}
