{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "callout",
  "type": "vawe:block",
  "title": "callout",
  "description": "a coloured info, success, or warning strip with a solid left bar and one line of text, for a note inline in a page.",
  "tags": [
    "callout"
  ],
  "dimensions": {
    "width": 584,
    "height": 106
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "callout",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 540,
      "text": "Same input, byte-identical output.",
      "tone": "success"
    },
    "props": [
      "x",
      "y",
      "text",
      "w",
      "body",
      "title",
      "tone",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/callout.json",
      "url": "https://vawe.dev/assets/blocks/callout.json",
      "target": "films/scene/callout.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/callout.png"
  }
}
