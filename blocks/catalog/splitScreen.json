{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "splitScreen",
  "type": "vawe:block",
  "title": "splitScreen",
  "description": "the screen divided into two side-by-side panes, or a small inset video in the corner like picture-in-picture",
  "tags": [
    "splitScreen"
  ],
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "splitScreen",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 540,
      "h": 96,
      "split": 0.5,
      "gap": 32,
      "divider": true,
      "left": {
        "block": "notification",
        "props": {
          "title": "Weekly digest",
          "body": "Kite Studio · Today"
        }
      },
      "right": {
        "block": "notification",
        "props": {
          "title": "Drafts",
          "body": "Fieldwork · Fri"
        }
      }
    },
    "props": [
      "x",
      "y",
      "w",
      "h",
      "orient",
      "split",
      "gap",
      "left",
      "right",
      "pip",
      "pipScale",
      "pipInset",
      "pipCorner",
      "divider",
      "lead",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/splitScreen.json",
      "url": "https://vawe.dev/assets/blocks/splitScreen.json",
      "target": "films/scene/splitScreen.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/splitScreen.png"
  }
}
