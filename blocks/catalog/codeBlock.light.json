  },
  "files": [
    {
      "source": "site/public/assets/blocks/codeBlock.light.json",
      "url": "https://vawe.dev/assets/blocks/codeBlock.light.json",
      "target": "films/scene/codeBlock.light.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/codeBlock.light.png"
