          "c": "S"
        },
        {
          "c": "e"
        },
        {
          "c": "a"
        },
        {
          "c": "r"
        },
        {
          "c": "c"
        },
        {
          "c": "h"
        }
      ]
    },
    "props": [
      "keyCue",
      "keyGain",
      "cursorStart",
      "x",
      "y",
      "w",
