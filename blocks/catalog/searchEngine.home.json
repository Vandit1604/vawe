      "logo",
      "logoW",
      "logoH",
      "query",
      "results",
      "markAlign",
      "cps",
      "clickIndex",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/searchEngine.home.json",
