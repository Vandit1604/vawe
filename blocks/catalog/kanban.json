{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "kanban",
  "type": "vawe:block",
  "title": "kanban",
  "description": "a kanban board: columns of small cards dealt in reading order, for a task board or pipeline view.",
  "tags": [
    "kanban"
  ],
  "dimensions": {
    "width": 604,
    "height": 165
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "kanban",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 560,
      "columns": [
        {
          "title": "Todo",
          "cards": [
            "captions",
            "TTS"
          ]
        },
        {
          "title": "Doing",
          "cards": [
            "blocks"
          ]
        },
        {
          "title": "Done",
          "cards": [
            "60fps",
            "lottie"
          ]
        }
      ]
    },
    "props": [
      "x",
      "y",
      "w",
      "columns",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/kanban.json",
      "url": "https://vawe.dev/assets/blocks/kanban.json",
      "target": "films/scene/kanban.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/kanban.png"
  }
}
