{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "slotSwap",
  "type": "vawe:beat",
  "title": "slotSwap",
  "description": "Fix a row of slots and turn its contents over N times at the same offsets. The right slot changes TYPE each pass so it never reads as a table.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expand with `make expand D=<scene.json>`",
    "layer": {
      "type": "beat",
      "beat": "slotSwap",
      "start": 0,
      "dur": 4,
      "offsets": null,
      "hold": null
    },
    "requiredProps": [
      "offsets",
      "hold"
    ],
    "props": [
      "passes",
      "x",
      "y",
      "badge",
      "badgeRadius",
      "gap",
      "labelW",
      "labelSize",
      "labelWeight",
      "labelColor",
      "badgeBg",
      "cx",
      "cy",
      "payloadW",
      "enterDur",
      "exitDur"
    ]
  }
}
