{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "htmlTable",
  "type": "vawe:beat",
  "title": "htmlTable",
  "description": "Show a real table that fills in row by row, never the whole grid at once.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "beat",
      "beat": "htmlTable",
      "start": 0,
      "dur": 4
    },
    "requiredProps": [],
    "props": [
      "x",
      "y",
      "w",
      "headers",
      "rows",
      "each",
      "stagger"
    ]
  }
}
