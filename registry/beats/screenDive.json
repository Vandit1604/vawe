{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "screenDive",
  "type": "vawe:beat",
  "title": "screenDive",
  "description": "Push the camera into the real product surface under a kinetic title.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "beat",
      "beat": "screenDive",
      "start": 0,
      "dur": 4,
      "title": null,
      "image": null,
      "caption": null,
      "captionSize": null
    },
    "requiredProps": [
      "title",
      "image",
      "caption",
      "captionSize"
    ],
    "props": [
      "x",
      "y",
      "w",
      "zoom"
    ]
  }
}
