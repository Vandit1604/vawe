{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "wordWipe",
  "type": "vawe:beat",
  "title": "wordWipe",
  "description": "Wipe the frame with one word roughly eight times the normal type size, motion-blurred, and land the reveal the instant it clears.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "beat",
      "beat": "wordWipe",
      "start": 0,
      "dur": 4,
      "word": null,
      "revealText": null,
      "subText": null
    },
    "requiredProps": [
      "word",
      "revealText",
      "subText"
    ],
    "props": [
      "color",
      "size",
      "scale",
      "weight",
      "wipeAt",
      "x",
      "w",
      "y"
    ]
  }
}
