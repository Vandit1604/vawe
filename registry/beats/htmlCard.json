{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "htmlCard",
  "type": "vawe:beat",
  "title": "htmlCard",
  "description": "Draw a card from your own markup and reveal its pieces one at a time, not as one flat card.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "beat",
      "beat": "htmlCard",
      "start": 0,
      "dur": 4,
      "h": null,
      "title": null,
      "select": null,
      "anim": null,
      "each": null,
      "stagger": null
    },
    "requiredProps": [
      "h",
      "title",
      "select",
      "anim",
      "each",
      "stagger"
    ],
    "props": [
      "x",
      "y",
      "w",
      "body",
      "accent"
    ]
  }
}
