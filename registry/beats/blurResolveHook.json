{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "blurResolveHook",
  "type": "vawe:beat",
  "title": "blurResolveHook",
  "description": "Open on a line that arrives smeared with motion blur and snaps into focus. It never slides, fades or scales.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blueprints/index.mjs); expand with `make expand D=<scene.json>`",
    "layer": {
      "type": "beat",
      "beat": "blurResolveHook",
      "start": 0,
      "dur": 4,
      "text": null,
      "font": null,
      "sub": null
    },
    "requiredProps": [
      "text",
      "font",
      "sub"
    ],
    "props": [
      "x",
      "y",
      "w",
      "size",
      "weight",
      "color",
      "align",
      "blurFrom",
      "resolveAt"
    ]
  }
}
