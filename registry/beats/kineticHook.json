    "requires": "vawe engine (blueprints/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "beat",
      "beat": "kineticHook",
      "start": 0,
      "dur": 4,
      "eyebrow": null,
      "to": null,
      "decimals": null,
      "word": null,
      "sub": null
    },
    "requiredProps": [
      "eyebrow",
      "to",
      "decimals",
      "word",
      "sub"
    ],
    "props": [
      "x",
      "y",
      "w",
      "unit",
      "wordSize",
      "heroSize"
    ]
  }
}
