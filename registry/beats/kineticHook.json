{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "kineticHook",
  "type": "vawe:beat",
  "title": "kineticHook",
  "description": "Open on a kinetic hook: eyebrow, one hero number or word that counts up, a subline that arrives word by word.",
  "tags": [
    "beat",
    "motion"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "install": {
