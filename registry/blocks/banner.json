{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "banner",
  "type": "vawe:block",
  "title": "banner",
  "description": "a full width coloured announcement bar with an icon, a message, and an optional CTA chip, spans the whole row edge to edge.",
  "tags": [
    "banner"
  ],
  "dimensions": {
    "width": 604,
    "height": 110
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expand with `make expand D=<scene.json>`",
    "layer": {
      "type": "block",
      "block": "banner",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 560,
      "text": "Now with 60fps export",
      "cta": "See how"
    },
    "props": [
      "x",
      "y",
      "w",
      "text",
      "body",
      "title",
      "cta",
      "icon",
      "accent",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/banner.json",
      "url": "https://vawe.dev/assets/blocks/banner.json",
      "target": "formats/scene/banner.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/banner.png"
  }
}
