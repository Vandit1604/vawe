{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "card.pricing",
  "type": "vawe:block",
  "title": "card.pricing",
  "description": "a pricing plan card: plan name, price per month, a ticked list of what you get, a sign up button",
  "tags": [
    "pricingCard"
  ],
  "dimensions": {
    "width": 384,
    "height": 321
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "card.pricing",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 340,
      "plan": "Pro",
      "price": "$29",
      "features": [
        "Unlimited renders",
        "Every format",
        "60fps export"
      ],
      "cta": "Start free",
      "highlight": true
    },
    "props": [
      "x",
      "y",
      "w",
      "plan",
      "price",
      "period",
      "features",
      "cta",
      "highlight",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/card.pricing.json",
      "url": "https://vawe.dev/assets/blocks/card.pricing.json",
      "target": "formats/scene/card.pricing.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/card.pricing.png"
  }
}
