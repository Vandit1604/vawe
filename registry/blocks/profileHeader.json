    "props": [
      "x",
      "y",
      "w",
      "avatar",
      "initials",
      "name",
      "handle",
      "stats",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/profileHeader.json",
      "url": "https://vawe.dev/assets/blocks/profileHeader.json",
      "target": "formats/scene/profileHeader.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
