{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "spinner",
  "type": "vawe:block",
  "title": "spinner",
  "description": "a small looping loading spinner animation for a busy or working state",
  "tags": [
    "spinner"
  ],
  "dimensions": {
    "width": 144,
    "height": 167
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "spinner",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "size": 90,
      "label": "rendering"
    },
    "props": [
      "x",
      "y",
      "size",
      "src",
      "label",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/spinner.json",
      "url": "https://vawe.dev/assets/blocks/spinner.json",
      "target": "formats/scene/spinner.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/spinner.png"
  }
}
