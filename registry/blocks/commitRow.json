{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "commitRow",
  "type": "vawe:block",
  "title": "commitRow",
  "description": "a git commit history list: hash, message, author and time per row, like a GitHub commits page",
  "tags": [
    "commitRow"
  ],
  "dimensions": {
    "width": 584,
    "height": 190
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expands automatically at load, no separate step",
    "layer": {
      "type": "block",
      "block": "commitRow",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 540,
      "commits": [
        {
          "hash": "d417051",
          "msg": "taste system + block registry",
          "author": "vandit",
          "time": "2m"
        },
        {
          "hash": "94b73bd",
          "msg": "migrate animation to interpolate()",
          "author": "vandit",
          "time": "1d"
        }
      ]
    },
    "props": [
      "x",
      "y",
      "w",
      "commits",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/commitRow.json",
      "url": "https://vawe.dev/assets/blocks/commitRow.json",
      "target": "formats/scene/commitRow.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/commitRow.png"
  }
}
