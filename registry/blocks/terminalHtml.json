    "props": [
      "x",
      "y",
      "w",
      "title",
      "command",
      "cps",
      "output",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/terminalHtml.json",
      "url": "https://vawe.dev/assets/blocks/terminalHtml.json",
      "target": "formats/scene/terminalHtml.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/terminalHtml.png"
