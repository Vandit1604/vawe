{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "terminalHtml",
  "type": "vawe:block",
  "title": "terminalHtml",
  "description": "the same deploy terminal as one hand-drawn console surface: gradient glass, per-word command colouring, a blinking text cursor",
  "tags": [
    "terminalHtml"
  ],
  "dimensions": {
    "width": 864,
    "height": 184
