{
  "$schema": "https://vawe.dev/schema/registry-item.json",
  "name": "notification",
  "type": "vawe:block",
  "title": "notification",
  "description": "a light system alert card that slides in from the edge, a status dot, a heading and a message, arrives and leaves like a phone banner.",
  "tags": [
    "notification"
  ],
  "dimensions": {
    "width": 484,
    "height": 125
  },
  "install": {
    "kind": "scene-layer",
    "target": "layers[]",
    "requires": "vawe engine (blocks/index.mjs); expand with `make expand D=<scene.json>`",
    "layer": {
      "type": "block",
      "block": "notification",
      "x": 160,
      "y": 160,
      "start": 0,
      "dur": 4,
      "w": 440,
      "title": "Render complete",
      "body": "out.mp4 is ready",
      "accent": "var(--up)"
    },
    "props": [
      "x",
      "y",
      "title",
      "body",
      "w",
      "message",
      "desc",
      "icon",
      "accent",
      "items",
      "life",
      "step",
      "rowH",
      "gap",
      "start",
      "dur"
    ]
  },
  "files": [
    {
      "source": "site/public/assets/blocks/notification.json",
      "url": "https://vawe.dev/assets/blocks/notification.json",
      "target": "formats/scene/notification.json",
      "type": "vawe:scene",
      "note": "pre-expanded: concrete layers only, renders without the block library"
    }
  ],
  "preview": {
    "poster": "https://vawe.dev/assets/blocks/notification.png"
  }
}
