{
  "title": "How one move becomes a page",
  "note": "Only a clip whose source hash changed re-renders. --all forces every clip.",
  "parts": [
    {
      "kind": "flow",
      "dir": "col",
      "steps": [
        {
          "name": "prompts/moves/",
          "note": "name.md + demo html"
        },
        {
          "name": "scripts/site/moves.mjs",
          "mark": "hi"
        }
      ]
    },
    {
      "kind": "list",
      "items": [
        {
          "name": "site/lib/moves.json"
        },
        {
          "name": "public/moves/name.md"
        },
        {
          "name": "llms.txt: Moves list"
        }
      ]
    },
    {
      "kind": "flow",
      "dir": "col",
      "steps": [
        {
          "name": "moves.mjs --clips",
          "note": "render if stale"
        },
        {
          "name": "name.mp4  name.webm\nname.webp (poster)"
        }
      ],
      "back": "clips.lock.json: source hash per clip"
    }
  ]
}
